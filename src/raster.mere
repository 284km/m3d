// A triangle rasterizer: which pixels a triangle covers, which of them survive
// the depth test, and what the attributes are worth at each of them.
//
// PURE. Nothing here opens a window or reads a file; a target is a buffer in
// and a buffer out, which is what lets the four backends be run against each
// other and what lets a Python implementation read the same answer. The window
// comes later and is a different question.
//
// THE FILL RULE IS THE WHOLE DESIGN. Two triangles that share an edge must
// cover every pixel along it EXACTLY ONCE -- not twice, which double-blends,
// and not zero times, which draws a seam of background through a solid mesh.
// The half-open convention that gets this right is the top-left rule: a pixel
// centre exactly on an edge belongs to the triangle if that edge is a top or a
// left edge, and to the other one otherwise. `test/raster_props.mere` checks
// the exactly-once property directly, with no oracle, because it is a fact
// about the answer rather than about the code.
//
// Screen space: pixel (x, y) is sampled at its CENTRE, (x + 0.5, y + 0.5), and
// y grows downward, which is what a framebuffer and glTF's texture origin both
// do. A front face is counter-clockwise in the source and therefore CLOCKWISE
// once y is flipped, so the sign test below reads the way it does on purpose.
import "./linalg.mere";
import "./srgb.mere";

// A vertex as the rasterizer sees it: already projected and viewport-mapped.
// `iw` is 1/w from the clip-space position and is what makes interpolation
// perspective-correct -- an attribute is carried as attribute/w, interpolated
// linearly in screen space, and divided by the interpolated 1/w at the end.
type rvert = { x: float, y: float, z: float, iw: float, r: float, g: float, b: float };

// Colour, and depth ALONGSIDE IT RATHER THAN INSIDE IT.
//
// This was forced when it was written: a record field could hold a `ByteBuf[R]`
// and could not hold a `Vec[R, T]`, a `StrBuf[R]` or a `Map[R, K, V]` -- the
// first three gave `expected &R unit, got &__heap unit`, because a record type
// had no way to be parameterised over the region its field's container lives
// in, and ByteBuf escaped that only because its region is erased from the
// type's tag. Tuples and function signatures were both fine, which is why the
// pair below works and a third field would not have.
//
// SINCE mere v0.1.456 A FIELD CAN HOLD ANY OF THEM, so this is now a shape and
// not a workaround: depth could be a third field. It has not been collapsed
// because the pair already cannot drift -- every function here takes the two
// together -- and the change would be a readability one across six signatures.
// See OPEN_QUESTIONS Q-8, which records the measurement on both compilers.
//
// Depth is a Vec of doubles rather than four more bytes because it is compared
// and not blended, and a byte has nowhere near the resolution a depth test
// needs. Every function here takes the two together so they cannot drift
// apart, and `Target.make` builds them as one value.
type target = { w: int, h: int, color: ByteBuf[R] };

module Target {
  // Depth starts at the far plane. NDC z runs -1 (near) to +1 (far) here, the
  // OpenGL convention `M4x.perspective_from_tan` produces, so "nothing drawn
  // yet" is +1 and the test is less-than.
  // Returns the pair, so a caller cannot end up holding a colour buffer and a
  // depth buffer of different sizes.
  let make = fn (w: int) -> fn (h: int) ->
    let d = vec_new () in
    let rec fill = fn (i: int) -> if i == w * h then () else let _ = vec_push d 1.0 in fill (i + 1) in
    let _ = fill 0 in
    (target { w = w, h = h, color = bytebuf_new (w * h * 4) }, d);

  let clear = fn (t: target) -> fn (depth) -> fn (r: int) -> fn (g: int) -> fn (b: int) ->
    let rec go = fn (i: int) ->
      if i == t.w * t.h then ()
      else
        let o = i * 4 in
        let _ = bytebuf_set t.color o r in
        let _ = bytebuf_set t.color (o + 1) g in
        let _ = bytebuf_set t.color (o + 2) b in
        let _ = bytebuf_set t.color (o + 3) 255 in
        let _ = vec_set depth i 1.0 in
        go (i + 1) in
    go 0;

  let get = fn (t: target) -> fn (x: int) -> fn (y: int) ->
    let o = (y * t.w + x) * 4 in
    (bytebuf_get t.color o, bytebuf_get t.color (o + 1), bytebuf_get t.color (o + 2));
}

module Raster {
  // The signed area of the triangle (a, b, p), doubled. Positive when the three
  // are clockwise in screen coordinates (y down). Every coverage question here
  // is three of these.
  let edge = fn (ax: float) -> fn (ay: float) -> fn (bx: float) -> fn (by: float) ->
             fn (px: float) -> fn (py: float) ->
    (bx - ax) * (py - ay) - (by - ay) * (px - ax);

  // THE TOP-LEFT RULE, and it is a rule about the EDGE and not about the pixel.
  // With y growing downward and the triangle wound CLOCKWISE in screen space --
  // which is what `triangle` below guarantees before it gets here:
  //   a TOP edge is horizontal (dy = 0) and goes RIGHT (dx > 0);
  //   a LEFT edge goes UP (dy < 0).
  // A pixel centre landing exactly on such an edge is inside; on any other edge
  // it is outside, and belongs to the neighbour that shares it. So a quad comes
  // out as the half-open box [x0, x1) x [y0, y1).
  //
  // BOTH SIGNS WERE THE OTHER WAY ROUND HERE FIRST, and the shared-edge property
  // still passed: the mirrored rule is just as consistent, it merely produces
  // (x0, x1] x (y0, y1] instead. Consistency does not pin the convention down --
  // the test that did is the one comparing the covered SET against the half-open
  // box, and it is why that assertion compares pixels rather than counting them.
  //
  // Exact equality and not a tolerance: two triangles sharing an edge compute it
  // from the same two vertices, so their edge functions are the same expression
  // and agree bit for bit. That is why exactly-once holds exactly.
  let is_top_left = fn (ax: float) -> fn (ay: float) -> fn (bx: float) -> fn (by: float) ->
    let dx = bx - ax in
    let dy = by - ay in
    (dy == 0.0 && dx > 0.0) || dy < 0.0;

  // Inside, given that edge function's value and which edge it came from.
  let accept = fn (e: float) -> fn (top_left: bool) ->
    if e > 0.0 then true else if e < 0.0 then false else top_left;

  // Draw one triangle. Back faces (counter-clockwise in screen space, so a
  // negative doubled area) are dropped when `cull` is set; a zero area is
  // always dropped, because a degenerate triangle has no inside and its edge
  // functions are all zero, which the rule above would otherwise read as "every
  // pixel is on every edge".
  let triangle = fn (t: target) -> fn (depth) -> fn (cull: bool) ->
                 fn (v0: rvert) -> fn (v1: rvert) -> fn (v2: rvert) ->
    let area = edge v0.x v0.y v1.x v1.y v2.x v2.y in
    if area == 0.0 then ()
    else if cull && area < 0.0 then ()
    else
      // A back face that survives (cull off) is wound the other way, so every
      // edge function has the opposite sign. Rather than branch inside the
      // loop, the vertices are swapped once so the body always sees a
      // clockwise triangle -- and the top-left rule stays a statement about
      // clockwise triangles, which is the only way it is well defined.
      let (a, b, c) = if area > 0.0 then (v0, v1, v2) else (v0, v2, v1) in
      let area = if area > 0.0 then area else 0.0 - area in
      let inv_area = 1.0 / area in
      // The bounding box, clamped to the target. `int_of_float` truncates
      // toward zero, so a negative left edge would round the wrong way; the
      // clamp to 0 happens before the conversion for that reason.
      let minxf = f_min a.x (f_min b.x c.x) in
      let maxxf = f_max a.x (f_max b.x c.x) in
      let minyf = f_min a.y (f_min b.y c.y) in
      let maxyf = f_max a.y (f_max b.y c.y) in
      let x0 = int_of_float (f_max 0.0 (floor minxf)) in
      let y0 = int_of_float (f_max 0.0 (floor minyf)) in
      let x1 = int_of_float (f_min (float_of_int t.w) (ceil maxxf)) in
      let y1 = int_of_float (f_min (float_of_int t.h) (ceil maxyf)) in
      let tl0 = is_top_left b.x b.y c.x c.y in
      let tl1 = is_top_left c.x c.y a.x a.y in
      let tl2 = is_top_left a.x a.y b.x b.y in
      let rec row = fn (y: int) ->
        if y >= y1 then ()
        else
          let py = float_of_int y + 0.5 in
          let rec col = fn (x: int) ->
            if x >= x1 then ()
            else
              let px = float_of_int x + 0.5 in
              // Named for the vertex OPPOSITE the edge, so e0 is the weight of
              // vertex a. That is the barycentric convention and keeps the
              // interpolation below from needing a comment of its own.
              let e0 = edge b.x b.y c.x c.y px py in
              let e1 = edge c.x c.y a.x a.y px py in
              let e2 = edge a.x a.y b.x b.y px py in
              let _ =
                if accept e0 tl0 && accept e1 tl1 && accept e2 tl2 then
                  let w0 = e0 * inv_area in
                  let w1 = e1 * inv_area in
                  let w2 = e2 * inv_area in
                  // Depth interpolates LINEARLY in screen space -- that is what
                  // a projection matrix's z/w is for -- while everything else
                  // needs the 1/w correction below.
                  let z = w0 * a.z + w1 * b.z + w2 * c.z in
                  let idx = y * t.w + x in
                  if z < vec_get depth idx then
                    let iw = w0 * a.iw + w1 * b.iw + w2 * c.iw in
                    let inv = 1.0 / iw in
                    let cr = (w0 * a.r * a.iw + w1 * b.r * b.iw + w2 * c.r * c.iw) * inv in
                    let cg = (w0 * a.g * a.iw + w1 * b.g * b.iw + w2 * c.g * c.iw) * inv in
                    let cb = (w0 * a.b * a.iw + w1 * b.b * b.iw + w2 * c.b * c.iw) * inv in
                    // THE STORE ENCODES, AND ONLY THE STORE. Interpolation
                    // happens in linear light -- which is the only place it is
                    // meaningful, because the transfer curve is not linear --
                    // and the curve is applied exactly once, here, at the point
                    // where a float becomes a display byte. Quantizing linearly
                    // instead loses the darks: eight bits of linear light puts
                    // a quarter of its codes above 0.75 and eleven of them below
                    // 0.01, which is banding you can see.
                    let q = Srgb.encode in
                    let o = idx * 4 in
                    let _ = vec_set depth idx z in
                    let _ = bytebuf_set t.color o (q cr) in
                    let _ = bytebuf_set t.color (o + 1) (q cg) in
                    let _ = bytebuf_set t.color (o + 2) (q cb) in
                    bytebuf_set t.color (o + 3) 255
                  else ()
                else () in
              col (x + 1) in
          let _ = col x0 in
          row (y + 1) in
      row y0;
}

// ---------------------------------------------------------------------------
// The shaded path: attributes to the pixel, and a shader called there.
//
// `Raster.triangle` above interpolates a COLOUR, which means a normal never
// reaches a pixel -- a sphere shows its triangles at the silhouette and a
// specular highlight lands on a vertex or misses. This one interpolates the
// attributes instead and calls a function at each covered pixel.
//
// IT IS A SECOND ENTRY POINT AND NOT A REPLACEMENT, on purpose. Everything
// above is pinned by test/raster_props.mere and by an exact-rational reference,
// and rewriting it to carry eleven attributes would have put that behind a
// change rather than beside one. The coverage rule, the top-left test and the
// depth comparison are literally the same functions; only what is interpolated
// differs.
// ---------------------------------------------------------------------------

// Screen position and 1/w, then the attributes a shader wants: where the point
// is in the world (for the view vector), which way the surface faces, where it
// lands in a texture, and the vertex colour glTF's COLOR_0 supplies.
type svert = {
  sx: float, sy: float, sz: float, siw: float,
  wx: float, wy: float, wz: float,
  nx: float, ny: float, nz: float,
  // TWO TEXTURE COORDINATE SETS, because glTF gives every material slot its own
  // `texCoord` index and two of the corpus's models use the second one -- an
  // occlusion map on TEXCOORD_1, an emissive map on TEXCOORD_1. A renderer that
  // carried one set would sample those with the wrong coordinates, which is a
  // picture rather than an error.
  su: float, sv: float,
  su1: float, sv1: float,
  // THE TWO VECTORS A TANGENT FRAME IS BUILT FROM. What they are depends on
  // whether the primitive supplied tangents, and the SHADER knows which -- it is
  // a property of the primitive, so it lives in the closure and not in here:
  //
  //   with TANGENT     `fa` is the tangent and `fb` the bitangent, interpolated
  //                    and re-normalized at the pixel.
  //   without          `fa` and `fb` are constant across the triangle and the
  //                    frame is cross(fa, N), cross(fb, N).
  //
  // Six floats serve both because the derived form collapses:
  // cross(q1,N)*a + cross(N,q0)*b is cross(q1*a - q0*b, N), so two vectors carry
  // what looked like four. And a cross product with N is PERPENDICULAR TO N by
  // construction, which is why the derived frame is right on a curved mesh
  // without any re-orthogonalising -- three.js's formula has the same shape for
  // the same reason.
  fax: float, fay: float, faz: float,
  fbx: float, fby: float, fbz: float,
  cr: float, cg: float, cb: float
};

module RasterS {
  // `shade` is called with the interpolated world position, the interpolated
  // and RE-NORMALIZED normal, BOTH texture coordinate sets and the vertex
  // colour, THE TWO TANGENT-FRAME VECTORS, and the vertex colour, and returns
  // linear light -- OR `None`, meaning this pixel is not drawn at all, which is
  // glTF's MASK alpha mode.
  //
  // Re-normalized because interpolating three unit vectors does not give a unit
  // vector -- it gives one that is short by however much they diverge, and a
  // short normal makes a surface darker toward the middle of every triangle,
  // which looks like faceting and is not.
  let triangle = fn (t: target) -> fn (depth) -> fn (cull: bool) ->
                 fn (a0: svert) -> fn (a1: svert) -> fn (a2: svert) -> fn (shade) ->
    let area = Raster.edge a0.sx a0.sy a1.sx a1.sy a2.sx a2.sy in
    if area == 0.0 then ()
    else if cull && area < 0.0 then ()
    else
      let (a, b, c) = if area > 0.0 then (a0, a1, a2) else (a0, a2, a1) in
      let area = if area > 0.0 then area else 0.0 - area in
      let inv_area = 1.0 / area in
      let x0 = int_of_float (f_max 0.0 (floor (f_min a.sx (f_min b.sx c.sx)))) in
      let y0 = int_of_float (f_max 0.0 (floor (f_min a.sy (f_min b.sy c.sy)))) in
      let x1 = int_of_float (f_min (float_of_int t.w) (ceil (f_max a.sx (f_max b.sx c.sx)))) in
      let y1 = int_of_float (f_min (float_of_int t.h) (ceil (f_max a.sy (f_max b.sy c.sy)))) in
      let tl0 = Raster.is_top_left b.sx b.sy c.sx c.sy in
      let tl1 = Raster.is_top_left c.sx c.sy a.sx a.sy in
      let tl2 = Raster.is_top_left a.sx a.sy b.sx b.sy in
      let rec row = fn (y: int) ->
        if y >= y1 then ()
        else
          let py = float_of_int y + 0.5 in
          let rec col = fn (x: int) ->
            if x >= x1 then ()
            else
              let px = float_of_int x + 0.5 in
              let e0 = Raster.edge b.sx b.sy c.sx c.sy px py in
              let e1 = Raster.edge c.sx c.sy a.sx a.sy px py in
              let e2 = Raster.edge a.sx a.sy b.sx b.sy px py in
              let _ =
                if Raster.accept e0 tl0 && Raster.accept e1 tl1 && Raster.accept e2 tl2 then
                  let w0 = e0 * inv_area in
                  let w1 = e1 * inv_area in
                  let w2 = e2 * inv_area in
                  let z = w0 * a.sz + w1 * b.sz + w2 * c.sz in
                  let idx = y * t.w + x in
                  if z < vec_get depth idx then
                    let iw = w0 * a.siw + w1 * b.siw + w2 * c.siw in
                    let inv = 1.0 / iw in
                    // Perspective-correct: every attribute is carried as
                    // attribute/w, interpolated linearly in screen space, and
                    // divided by the interpolated 1/w. Screen-linear
                    // interpolation of an attribute is the wobbling-texture bug.
                    let pc = fn (va: float) -> fn (vb: float) -> fn (vc: float) ->
                      (w0 * va * a.siw + w1 * vb * b.siw + w2 * vc * c.siw) * inv in
                    let wp = v3 { x = pc a.wx b.wx c.wx,
                                  y = pc a.wy b.wy c.wy,
                                  z = pc a.wz b.wz c.wz } in
                    let n = V3.normalize (v3 { x = pc a.nx b.nx c.nx,
                                               y = pc a.ny b.ny c.ny,
                                               z = pc a.nz b.nz c.nz }) in
                    let uu = pc a.su b.su c.su in
                    let vv = pc a.sv b.sv c.sv in
                    let uu1 = pc a.su1 b.su1 c.su1 in
                    let vv1 = pc a.sv1 b.sv1 c.sv1 in
                    let fa = v3 { x = pc a.fax b.fax c.fax,
                                  y = pc a.fay b.fay c.fay,
                                  z = pc a.faz b.faz c.faz } in
                    let fb = v3 { x = pc a.fbx b.fbx c.fbx,
                                  y = pc a.fby b.fby c.fby,
                                  z = pc a.fbz b.fbz c.fbz } in
                    let vc = v3 { x = pc a.cr b.cr c.cr,
                                  y = pc a.cg b.cg c.cg,
                                  z = pc a.cb b.cb c.cb } in
                    // THE SHADER MAY DECLINE A PIXEL, and that is what glTF's
                    // MASK alpha mode is: not a colour but a coverage decision,
                    // taken per pixel after the texture has been sampled.
                    //
                    // A DECLINED PIXEL MUST NOT WRITE DEPTH. It is a hole, and a
                    // hole that occludes is worse than no hole at all -- whatever
                    // is behind it disappears, which looks like a z-buffer bug a
                    // long way from here.
                    //
                    // Annotated because the closure is a parameter and its
                    // result type has nothing to be inferred from at this call.
                    match (shade wp n uu vv uu1 vv1 fa fb vc : v3 option) with
                    | None -> ()
                    | Some lit ->
                      let o = idx * 4 in
                      let _ = vec_set depth idx z in
                      let _ = bytebuf_set t.color o (Srgb.encode lit.x) in
                      let _ = bytebuf_set t.color (o + 1) (Srgb.encode lit.y) in
                      let _ = bytebuf_set t.color (o + 2) (Srgb.encode lit.z) in
                      bytebuf_set t.color (o + 3) 255
                  else ()
                else () in
              col (x + 1) in
          let _ = col x0 in
          row (y + 1) in
      row y0;
}
// ---------------------------------------------------------------------------
// Points and lines
// ---------------------------------------------------------------------------
//
// A THIRD ENTRY POINT, not a widening of the second. `RasterS.triangle` is pinned
// by the coverage properties and by an exact-rational reference, and neither has
// anything to say about a one-pixel dot -- so these are beside it and share the
// depth test rather than reaching through it.
//
// THEY ARE UNLIT, and that is what the reference does rather than a shortcut:
// three.js's GLTFLoader swaps a glTF material for a `PointsMaterial` or a
// `LineBasicMaterial` for these modes, carrying over only `color` and `map`. Both
// are unlit, so the normal is not consulted and the emissive factor is dropped.
// Its own comment on the point size reads "glTF spec says points should be 1px".
module RasterP {
  // One pixel, depth-tested. `shade` takes nothing: a point has no normal to
  // interpolate and no area to interpolate across.
  let point = fn (t: target) -> fn (depth) -> fn (sx: float) -> fn (sy: float) ->
              fn (z: float) -> fn (lit: v3) ->
    let x = int_of_float (floor sx) in
    let y = int_of_float (floor sy) in
    if x < 0 || y < 0 || x >= t.w || y >= t.h then ()
    else
      let idx = y * t.w + x in
      if z >= vec_get depth idx then ()
      else
        let o = idx * 4 in
        let _ = vec_set depth idx z in
        let _ = bytebuf_set t.color o (Srgb.encode lit.x) in
        let _ = bytebuf_set t.color (o + 1) (Srgb.encode lit.y) in
        let _ = bytebuf_set t.color (o + 2) (Srgb.encode lit.z) in
        bytebuf_set t.color (o + 3) 255;

  // A one-pixel line, Bresenham, with depth and colour carried along it.
  //
  // BRESENHAM RATHER THAN STEPPING A FLOAT, because a float step accumulates and
  // a long line drifts off its own endpoint. The colour and 1/w are interpolated
  // by the fraction of the LONG axis travelled, which is what makes the two ends
  // land on their own values.
  //
  // Perspective-correct the same way the triangle is: the attribute is carried as
  // attribute/w, interpolated, and divided by the interpolated 1/w.
  let line = fn (t: target) -> fn (depth) ->
             fn (ax: float) -> fn (ay: float) -> fn (az: float) -> fn (aw: float) -> fn (ca: v3) ->
             fn (bx: float) -> fn (by: float) -> fn (bz: float) -> fn (bw: float) -> fn (cb: v3) ->
    let x0 = int_of_float (floor ax) in
    let y0 = int_of_float (floor ay) in
    let x1 = int_of_float (floor bx) in
    let y1 = int_of_float (floor by) in
    let dx = if x1 > x0 then x1 - x0 else x0 - x1 in
    let dy = if y1 > y0 then y1 - y0 else y0 - y1 in
    let n = if dx > dy then dx else dy in
    let sxs = if x1 > x0 then 1 else 0 - 1 in
    let sys = if y1 > y0 then 1 else 0 - 1 in
    let rec go = fn (k: int) -> fn (x: int) -> fn (y: int) -> fn (err: int) ->
      if k > n then ()
      else
        let f = if n == 0 then 0.0 else float_of_int k / float_of_int n in
        let iw = aw + (bw - aw) * f in
        let z = az + (bz - az) * f in
        let pc = fn (va: float) -> fn (vb: float) ->
          if iw == 0.0 then va else (va * aw + (vb * bw - va * aw) * f) / iw in
        let _ =
          if x < 0 || y < 0 || x >= t.w || y >= t.h then ()
          else
            let idx = y * t.w + x in
            if z >= vec_get depth idx then ()
            else
              let o = idx * 4 in
              let _ = vec_set depth idx z in
              let _ = bytebuf_set t.color o (Srgb.encode (pc ca.x cb.x)) in
              let _ = bytebuf_set t.color (o + 1) (Srgb.encode (pc ca.y cb.y)) in
              let _ = bytebuf_set t.color (o + 2) (Srgb.encode (pc ca.z cb.z)) in
              bytebuf_set t.color (o + 3) 255 in
        // The two-error form, so the step is integer and there is no accumulation.
        let e2 = 2 * err in
        let (nx, ne) = if e2 > 0 - dy then (x + sxs, err - dy) else (x, err) in
        let (ny, ne2) = if e2 < dx then (y + sys, ne + dx) else (y, ne) in
        go (k + 1) nx ny ne2 in
    go 0 x0 y0 (dx - dy);
}
