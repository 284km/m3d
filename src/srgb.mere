  // A colour byte as it was meant: sRGB is a transfer curve and not a linear
  // scale, so a baseColor texture has to come through here before it is lit.
  let decode = fn (b: int) ->
    if b <= 0 then 0.0 else if b >= 255 then 1.0 else vec_get _dec b;

  // And back. Binary search over the thresholds -- eight comparisons, no pow.
  let encode = fn (c: float) ->
    if c <= 0.0 then 0
    else if c >= 1.0 then 255
    else if c < vec_get _thr 0 then 0
    else
      let rec go = fn (lo: int) -> fn (hi: int) ->
        if lo >= hi then lo + 1
        else
          let m = (lo + hi + 1) / 2 in
          if c >= vec_get _thr m then go m hi else go lo (m - 1) in
