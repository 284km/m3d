  // Linear in, linear out: a value that is already linear (a metallic factor, a
  // roughness) must NOT go through the curve, and having the plain one named
  // makes the two impossible to mix up at a call site.
  let quantize_linear = fn (c: float) ->
    let s = c * 255.0 in
    if s <= 0.0 then 0 else if s >= 255.0 then 255 else int_of_float (s + 0.5);
