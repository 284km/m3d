// The scene graph, the camera, and one frame.
//
// PURE, like everything below it: a document in, a framebuffer out. `main.mere`
// is what touches the disk, and it is glue -- if anything but glue ends up
// there, this file is missing something.
//
// THE CAMERA IS COMPUTED AND THEN PRINTED, which is a gate's requirement rather
// than a renderer's. Most glTF sample models carry no camera, so a viewer has
// to invent one from the scene's bounds; two viewers inventing one
// independently will not agree, and then a pixel comparison against a reference
// renderer would be measuring the framing heuristic. So this one computes the
// framing, `main.mere` prints the numbers, and the reference is handed the same
// numbers rather than asked to guess the same way.
import "./gltf.mere";
import "./raster.mere";
import "./shade.mere";
import "./texture.mere";

// A texture as a material slot uses it: the decoded image plus the sampler
// state that says how to read outside [0,1] and whether to blend. The sampler
// is NOT folded into `texture`, because the same image can be referenced by two
// textures with different wrap modes and decoding it twice to say so would be a
// lie about what the file contains.
type texslot = { img: texture, ws: int, wt: int, mag: int,
                 // WHICH COORDINATE SET, from the slot's own `texCoord`. It is a
                 // property of the SLOT and not of the mesh: MultiUVTest puts its
                 // base colour on TEXCOORD_0 and its emissive on TEXCOORD_1, in
                 // one material.
                 uvset: int };

module Scene {
  // A node's local transform: `matrix` if it has one, otherwise TRS. glTF says
  // a node has one or the other and never both, and the defaults are not all
  // zero -- scale is 1 and rotation is the identity quaternion.
  let local = fn (nd: Json.json) ->
    match J.field nd "matrix" with
    | Some m ->
      let g = fn (i: int) -> match J.at m i with | None -> 0.0 | Some x -> J.flt x in
      // Column-major in the file, which is the layout `mat4` already uses.
      mat4 { c0 = v4 { x = g 0,  y = g 1,  z = g 2,  w = g 3 },
             c1 = v4 { x = g 4,  y = g 5,  z = g 6,  w = g 7 },
             c2 = v4 { x = g 8,  y = g 9,  z = g 10, w = g 11 },
             c3 = v4 { x = g 12, y = g 13, z = g 14, w = g 15 } }
    | None ->
      let arr3 = fn (k: str) -> fn (d: float) ->
        match J.field nd k with
        | None -> v3 { x = d, y = d, z = d }
        | Some a ->
          let g = fn (i: int) -> match J.at a i with | None -> d | Some x -> J.flt x in
          v3 { x = g 0, y = g 1, z = g 2 } in
      let t = arr3 "translation" 0.0 in
      let s = arr3 "scale" 1.0 in
      let r = match J.field nd "rotation" with
              | None -> Q.identity
              | Some a ->
                let g = fn (i: int) -> match J.at a i with | None -> 0.0 | Some x -> J.flt x in
                // glTF stores a quaternion xyzw, w last.
                quat { x = g 0, y = g 1, z = g 2, w = g 3 } in
      M4x.trs t r s;

  // The node's local transform, WITH ANY ANIMATION APPLIED. The mask decides per
  // channel: an animated translation replaces the node's, and an unanimated one
  // keeps it. Deciding per NODE instead would make a rotation-only animation zero
  // the node's translation.
  let local_at = fn (nd: Json.json) -> fn (ni: int) -> fn (st) ->
    let (ats, ars, ass, mask, _wo, _wc, _wv) = st in
    let m = if ni >= 0 && ni < vec_len mask then vec_get mask ni else 0 in
    if m == 0 then local nd
    else
      // A node carrying `matrix` cannot be animated -- glTF forbids it -- so
      // reaching here with one is a broken file rather than a case to handle.
      let _ = match J.field nd "matrix" with
              | None -> ()
              | Some _ -> fail ("gltf: node " ++ str_of_int ni ++ " has a `matrix` and is "
                                ++ "animated, which glTF does not allow") in
      let base = fn (k: str) -> fn (dv: float) ->
        match J.field nd k with
        | None -> v3 { x = dv, y = dv, z = dv }
        | Some a ->
          let g = fn (i: int) -> match J.at a i with | None -> dv | Some x -> J.flt x in
          v3 { x = g 0, y = g 1, z = g 2 } in
      let t = if bit_and m 1 != 0 then (vec_get ats ni : v3) else base "translation" 0.0 in
      let s = if bit_and m 4 != 0 then (vec_get ass ni : v3) else base "scale" 1.0 in
      let r = if bit_and m 2 != 0 then (vec_get ars ni : quat)
              else match J.field nd "rotation" with
                   | None -> Q.identity
                   | Some a ->
                     let g = fn (i: int) -> match J.at a i with | None -> 0.0 | Some x -> J.flt x in
                     quat { x = g 0, y = g 1, z = g 2, w = g 3 } in
      M4x.trs t r s;

  let nodes = fn (d: doc) -> match J.field d.j "nodes" with | None -> Json.JArr Nil | Some v -> v;

  // The roots of the default scene, or every node if there are no scenes --
  // which some test files genuinely are.
  let roots = fn (d: doc) ->
    match J.field d.j "scenes" with
    | None ->
      let n = J.arr_len (nodes d) in
      let v = vec_new () in
      let rec go = fn (i: int) -> if i == n then () else let _ = vec_push v i in go (i + 1) in
      let _ = go 0 in v
    | Some scenes ->
      let idx = J.int_or d.j "scene" 0 in
      let sc = match J.at scenes idx with
               | None -> fail ("gltf: scene " ++ str_of_int idx ++ " is not there")
               | Some x -> x in
      let v = vec_new () in
      let rec go = fn (xs) ->
        match xs with
        | Nil -> ()
        | Cons (h, t) -> let _ = vec_push v (J.int_ h) in go t in
      let _ = go (match J.field sc "nodes" with | None -> Nil | Some a -> J.arr a) in
      v;

  // `f` is called with (node index, world matrix) for every node reachable from
  // the scene's roots. Depth-first, children after their parent, so a world
  // matrix is always the parent's times the child's local one.
  //
  // No cycle guard: glTF says the node graph is a forest, and the Khronos
  // validator refuses a file where it is not -- which is a check this project
  // already runs over its corpus, so duplicating it here would be duplicating
  // it rather than adding anything.
  // ---------------------------------------------------------------------------
  // Animation, evaluated at one instant
  // ---------------------------------------------------------------------------
  //
  // A node's animated translation, rotation and scale, in three arrays indexed by
  // NODE, plus a mask saying which of the three an animation actually drives. A
  // channel that is not animated must keep the node's own value, and a mask is how
  // "not animated" is told from "animated to zero" -- a scale of zero is a real
  // thing a file can ask for.
  //
  // EVERY ANIMATION IS APPLIED, not the first. `InterpolationTest` has NINE, each
  // targeting a different node, and it exists to show three interpolations across
  // three paths side by side; playing one would show a ninth of it.
  //
  // A node with a `matrix` cannot be animated -- glTF forbids the combination --
  // so these only ever override TRS.
  // ONE ANIMATION, CHOSEN, and not all of them at once.
  //
  // glTF does not say which animation a viewer should play, and "all" is not a
  // well-defined answer: Fox carries three -- Survey, Walk and Run -- that drive
  // THE SAME BONES, and they are alternatives rather than layers. three.js's
  // AnimationMixer BLENDS concurrent clips, dividing by their total weight, so
  // three at once give an average of the three; applying them in order instead
  // lets the last one win. Neither is wrong and they are not each other: Fox
  // measured 18.5 against the reference that way, where every other animated
  // model was under 0.11.
  //
  // So the choice is a parameter with a default of zero, and the reference is
  // given the same index. InterpolationTest's nine animations target nine
  // separate nodes and would be safe to run together, but a rule that is safe
  // for one model and ambiguous for another is not a rule.
  let s0_of = fn (s2: float) -> 1.0 - s2;

  let anim_state_of = fn (d: doc) -> fn (time: float) -> fn (which: int) ->
    let n = J.len (J.arr (nodes d)) in
    let ts = vec_new () in
    let rs = vec_new () in
    let ss = vec_new () in
    let mask = vec_new () in
    // ANIMATED MORPH WEIGHTS, which a `weights` channel drives. Variable length
    // per node -- a node's count is its mesh's target count -- so they live in one
    // flat array with an offset and a count per node. -1 for "this node's weights
    // are not animated", which is not the same as "animated to zero": a mesh's own
    // `weights` must survive the first and be overridden by the second.
    let woff = vec_new () in
    let wcnt = vec_new () in
    let wval = vec_new () in
    let rec fill = fn (i: int) ->
      if i >= n then ()
      else
        let _ = vec_push ts (v3 { x = 0.0, y = 0.0, z = 0.0 }) in
        let _ = vec_push rs Q.identity in
        let _ = vec_push ss (v3 { x = 1.0, y = 1.0, z = 1.0 }) in
        let _ = vec_push mask 0 in
        let _ = vec_push woff (0 - 1) in
        let _ = vec_push wcnt 0 in
        fill (i + 1) in
    let _ = fill 0 in
    let _ =
      match J.field d.j "animations" with
      | None -> ()
      | Some av ->
        let anims = J.arr av in
        let nan = J.len anims in
        let _ = if which >= nan
                then fail ("gltf: animation " ++ str_of_int which ++ " was asked for and the "
                           ++ "document has " ++ str_of_int nan)
                else () in
        let rec each = fn (xs) -> fn (ai: int) ->
          match xs with
          | Nil -> ()
          | Cons (a, rest) ->
            if ai != which then each rest (ai + 1) else
            let sampv = J.arr (J.req a "samplers") in
            let rec chans = fn (cs) ->
              match cs with
              | Nil -> ()
              | Cons (ch, crest) ->
                let _ =
                  let tgt = J.req ch "target" in
                  match J.field tgt "node" with
                  | None -> ()
                  | Some nj ->
                    let ni = J.int_ nj in
                    let path = J.str_ (J.req tgt "path") in
                    let sp = match J.at (J.req a "samplers") (J.int_ (J.req ch "sampler")) with
                             | None -> fail "gltf: a channel names a sampler that is not there"
                             | Some x -> x in
                    let interp = J.str_or sp "interpolation" "LINEAR" in
                    let tin = Acc.floats d (J.int_ (J.req sp "input")) in
                    let out = Acc.floats d (J.int_ (J.req sp "output")) in
                    let nk = vec_len tin in
                    if nk == 0 || ni < 0 || ni >= n then ()
                    else
                      // OUTSIDE THE RANGE THE ENDS HOLD. Before the first key and
                      // after the last, the value is that key's -- three.js's
                      // Interpolant clamps and so does this. Extrapolating a cubic
                      // spline past its last tangent flies off.
                      let (k0, k1, f) =
                        if time <= vec_get tin 0 then (0, 0, 0.0)
                        else if time >= vec_get tin (nk - 1) then (nk - 1, nk - 1, 0.0)
                        else
                          let rec find = fn (i: int) ->
                            if i + 1 >= nk then (nk - 1, nk - 1, 0.0)
                            else if time < vec_get tin (i + 1) then
                              let t0 = vec_get tin i in
                              let t1 = vec_get tin (i + 1) in
                              let td = t1 - t0 in
                              (i, i + 1, if td == 0.0 then 0.0 else (time - t0) / td)
                            else find (i + 1) in
                          find 0 in
                      let td = if k1 == k0 then 0.0 else vec_get tin k1 - vec_get tin k0 in
                      if str_eq path "weights" then
                        // HOW MANY WEIGHTS is the output's length divided by the
                        // keyframe count -- and by three more for CUBICSPLINE,
                        // whose groups are [inTangent, vertex, outTangent]. There
                        // is no other place to learn it: the accessor is SCALAR.
                        let stepw = if str_eq interp "CUBICSPLINE" then 3 else 1 in
                        let nw = vec_len out / (nk * stepw) in
                        if nw <= 0 then ()
                        else
                          let base = vec_len wval in
                          let gw = fn (k: int) -> fn (c: int) ->
                            vec_get out ((k * nw + c) * stepw
                                         + (if stepw == 3 then 1 else 0)) in
                          let tgw = fn (k: int) -> fn (c: int) -> fn (which: int) ->
                            vec_get out ((k * nw + c) * 3 + which) in
                          let rec put = fn (c: int) ->
                            if c >= nw then ()
                            else
                              let v =
                                if str_eq interp "STEP" then gw k0 c
                                else if str_eq interp "CUBICSPLINE" then
                                  let p = f in
                                  let pp = p * p in
                                  let ppp = pp * p in
                                  let s2 = 0.0 - 2.0 * ppp + 3.0 * pp in
                                  let s3 = ppp - pp in
                                  s0_of s2 * gw k0 c + (s3 - pp + p) * (tgw k0 c 2 * td)
                                  + s2 * gw k1 c + s3 * (tgw k1 c 0 * td)
                                else gw k0 c + (gw k1 c - gw k0 c) * f in
                              let _ = vec_push wval v in
                              put (c + 1) in
                          let _ = put 0 in
                          let _ = vec_set woff ni base in
                          vec_set wcnt ni nw
                      else
                      let ncomp = if str_eq path "rotation" then 4 else 3 in
                      let step = if str_eq interp "CUBICSPLINE" then 3 else 1 in
                      // For CUBICSPLINE the output holds three values a keyframe --
                      // [inTangent, vertex, outTangent] -- so the VERTEX sits one
                      // stride into the group. Reading the group's first value
                      // instead gives the in-tangent, which is a plausible-looking
                      // wrong animation.
                      let g = fn (k: int) -> fn (c: int) ->
                        vec_get out (k * ncomp * step + (if step == 3 then ncomp else 0) + c) in
                      let tg = fn (k: int) -> fn (c: int) -> fn (which: int) ->
                        vec_get out (k * ncomp * 3 + which * ncomp + c) in
                      let comp = fn (c: int) ->
                        if str_eq interp "STEP" then g k0 c
                        else if str_eq interp "CUBICSPLINE" then
                          let p = f in
                          let pp = p * p in
                          let ppp = pp * p in
                          let s2 = 0.0 - 2.0 * ppp + 3.0 * pp in
                          let s3 = ppp - pp in
                          let s0 = 1.0 - s2 in
                          let s1 = s3 - pp + p in
                          // THE TANGENTS ARE SCALED BY THE TIME DELTA. Without it
                          // the curve is right in shape and wrong in slope, which
                          // reads as an animation that overshoots or lags.
                          let m0 = tg k0 c 2 * td in
                          let m1 = tg k1 c 0 * td in
                          s0 * g k0 c + s1 * m0 + s2 * g k1 c + s3 * m1
                        else g k0 c + (g k1 c - g k0 c) * f in
                      if str_eq path "rotation" then
                        let q =
                          if str_eq interp "STEP" then
                            quat { x = g k0 0, y = g k0 1, z = g k0 2, w = g k0 3 }
                          else if str_eq interp "CUBICSPLINE" then
                            // The spline runs componentwise and the result is then
                            // NORMALIZED, which is what glTF requires and what
                            // three.js's quaternion variant does.
                            Q.normalize (quat { x = comp 0, y = comp 1,
                                                z = comp 2, w = comp 3 })
                          else
                            // LINEAR ON A ROTATION IS SLERP, not a lerp. See Q.slerp.
                            Q.slerp (quat { x = g k0 0, y = g k0 1, z = g k0 2, w = g k0 3 })
                                    (quat { x = g k1 0, y = g k1 1, z = g k1 2, w = g k1 3 })
                                    f in
                        let _ = vec_set rs ni q in
                        vec_set mask ni (bit_or (vec_get mask ni) 2)
                      else if str_eq path "translation" then
                        let _ = vec_set ts ni (v3 { x = comp 0, y = comp 1, z = comp 2 }) in
                        vec_set mask ni (bit_or (vec_get mask ni) 1)
                      else if str_eq path "scale" then
                        let _ = vec_set ss ni (v3 { x = comp 0, y = comp 1, z = comp 2 }) in
                        vec_set mask ni (bit_or (vec_get mask ni) 4)
                      else () in
                chans crest in
            let _ = chans (J.arr (J.req a "channels")) in
            each rest (ai + 1) in
        each anims 0 in
    (ts, rs, ss, mask, woff, wcnt, wval);

  let anim_state = fn (d: doc) -> fn (time: float) -> anim_state_of d time 0;

  let walk_at = fn (d: doc) -> fn (st) -> fn (f) ->
    let ns = nodes d in
    let rec visit = fn (i: int) -> fn (parent: mat4) ->
      match J.at ns i with
      | None -> ()
      | Some nd ->
        let w = M4.mul parent (local_at nd i st) in
        let _ = f i nd w in
        let rec kids = fn (xs) ->
          match xs with
          | Nil -> ()
          | Cons (h, t) -> let _ = visit (J.int_ h) w in kids t in
        kids (match J.field nd "children" with | None -> Nil | Some a -> J.arr a) in
    let rs = roots d in
    let rec go = fn (k: int) ->
      if k == vec_len rs then ()
      else let _ = visit (vec_get rs k) M4.identity in go (k + 1) in
    go 0;

  // The still scene, which is what everything with no time to speak of wants.
  //
  // Built by asking for AN ANIMATION THAT DOES NOT EXIST rather than by making
  // empty arrays: an empty `vec_new ()` inside a tuple leaves the C backend with
  // no element type to resolve, and index -1 matches no animation, so the arrays
  // come out correctly sized and typed with every mask at zero -- which is what
  // makes each lookup fall through to the node's own transform.
  let still = fn (d: doc) -> anim_state_of d 0.0 (0 - 1);
  let walk = fn (d: doc) -> fn (f) -> walk_at d (still d) f;

  // EVERY NODE'S WORLD MATRIX, INDEXED BY NODE.
  //
  // `walk` hands each node its own matrix as it goes, which is all a mesh needs.
  // A SKIN NEEDS SOMEBODY ELSE'S: its joints are node indices that can point
  // anywhere in the scene, including at nodes not yet visited and at nodes that
  // are not ancestors of the mesh. So the whole tree is resolved first, into an
  // array, and skinning reads from that.
  //
  // A node no root reaches keeps the identity. That is not a guess about what it
  // means -- glTF says a node not in the scene graph is not part of the scene --
  // and a joint pointing at one would be a broken file, which the skin reader
  // refuses by name rather than silently skinning against the identity.
  let world_matrices_at = fn (d: doc) -> fn (st) ->
    let n = J.len (J.arr (nodes d)) in
    let out = vec_new () in
    let rec fill = fn (i: int) ->
      if i >= n then () else let _ = vec_push out M4.identity in fill (i + 1) in
    let _ = fill 0 in
    let _ = walk_at d st (fn (i: int) -> fn (nd: Json.json) -> fn (w: mat4) -> vec_set out i w) in
    out;

  let world_matrices = fn (d: doc) -> world_matrices_at d (still d);
}

module Frame {
  // The world-space bounding box of everything that will be drawn. Taken from
  // each POSITION accessor's own `min`/`max` when the file gives them -- glTF
  // REQUIRES them on POSITION, so this is not a shortcut -- transformed by the
  // node's matrix. All eight corners, because a rotation turns a box into a box
  // with different corners and taking only two of them shrinks it.
  let bounds_at = fn (d: doc) -> fn (st) ->
    let lo = vec_new () in let hi = vec_new () in
    let _ = vec_push lo 1e30 in let _ = vec_push lo 1e30 in let _ = vec_push lo 1e30 in
    let _ = vec_push hi (0.0 - 1e30) in let _ = vec_push hi (0.0 - 1e30) in let _ = vec_push hi (0.0 - 1e30) in
    let see = fn (p: v3) ->
      let ax = fn (k: int) -> fn (val: float) ->
        let _ = if val < vec_get lo k then vec_set lo k val else () in
        if val > vec_get hi k then vec_set hi k val else () in
      let _ = ax 0 p.x in let _ = ax 1 p.y in ax 2 p.z in
    let _ = Scene.walk_at d st (fn (i: int) -> fn (nd: Json.json) -> fn (w: mat4) ->
      match J.field nd "mesh" with
      | None -> ()
      | Some mi ->
        let mesh = match J.at (J.req d.j "meshes") (J.int_ mi) with
                   | None -> fail "gltf: node names a mesh that is not there"
                   | Some x -> x in
        let rec prims = fn (xs) ->
          match xs with
          | Nil -> ()
          | Cons (pr, rest) ->
            let _ =
              match J.field (J.req pr "attributes") "POSITION" with
              | None -> ()
              | Some pa ->
                let acc = match J.at (J.req d.j "accessors") (J.int_ pa) with
                          | None -> fail "gltf: no such accessor" | Some x -> x in
                match (J.field acc "min", J.field acc "max") with
                | (Some mn, Some mx) ->
                  let g = fn (a: Json.json) -> fn (k: int) ->
                    match J.at a k with | None -> 0.0 | Some x -> J.flt x in
                  let rec corner = fn (c: int) ->
                    if c == 8 then ()
                    else
                      let pick = fn (k: int) ->
                        if bit_and (bit_shr c k) 1 == 0 then g mn k else g mx k in
                      // mul_POINT: a corner is a position, so the translation
                      // applies. An earlier line here also fed the mul_dir of
                      // the same corner into the bounds, which is the same
                      // point with the translation dropped -- it made every box
                      // include the untranslated copy of itself and framed the
                      // camera too wide.
                      let _ = see (V4.xyz (M4.mul_point w (v3 { x = pick 0, y = pick 1, z = pick 2 }))) in
                      corner (c + 1) in
                  corner 0
                | _ -> () in
            prims rest in
        prims (J.arr (J.req mesh "primitives"))) in
    (v3 { x = vec_get lo 0, y = vec_get lo 1, z = vec_get lo 2 },
     v3 { x = vec_get hi 0, y = vec_get hi 1, z = vec_get hi 2 });

  // A camera that fits the scene, from a fixed direction. Deterministic, and
  // printed by main.mere so a reference renderer can be handed the same one
  // rather than asked to invent the same one.
  let bounds = fn (d: doc) -> bounds_at d (Scene.still d);

  let auto_camera_at = fn (d: doc) -> fn (aspect: float) -> fn (st) ->
    let (lo, hi) = bounds_at d st in
    let c = V3.scale (V3.add lo hi) 0.5 in
    let r = V3.length (V3.scale (V3.sub hi lo) 0.5) in
    let r = if r <= 0.0 then 1.0 else r in
    // 45 degrees vertical. A sphere of radius r just fits at r / sin(fov/2) --
    // sin and not tan, because the frame is tangent to the sphere rather than
    // passing through its centre -- and 1.15 leaves a margin so the silhouette
    // does not touch the edge.
    //
    // sin comes from tan by identity and a sqrt, both correctly rounded, so the
    // framing stays exact and does not drag a trigonometric function onto the
    // path. The first version divided by tan and multiplied by 2.4, which is
    // 2.2x too far: Duck came out 779 pixels of a 128x128 frame.
    let tan_half = 0.41421356237309503 in
    let sin_half = tan_half / sqrt (1.0 + tan_half * tan_half) in
    let dist = r / sin_half * 1.15 in
    let dir = V3.normalize (v3 { x = 0.7, y = 0.5, z = 1.0 }) in
    let eye = V3.add c (V3.scale dir dist) in
    let znear = dist * 0.01 in
    let zfar = dist + r * 4.0 in
    (eye, c, tan_half, znear, zfar,
     M4.mul (M4x.perspective_from_tan tan_half aspect znear zfar)
            (M4x.look_at eye c (v3 { x = 0.0, y = 1.0, z = 0.0 })));

  let auto_camera = fn (d: doc) -> fn (aspect: float) ->
    auto_camera_at d aspect (Scene.still d);

  // ------------------------------------------------------------------------
  // AN ORBIT CAMERA, AS PURE FUNCTIONS. A mouse moves a camera, and a mouse is
  // not something a gate can hold -- so the interaction is defined here as
  // arithmetic on a state, and the window is left with nothing but the job of
  // turning events into calls. Everything below can be asserted without a
  // display, and `test/render_props.mere` does.
  //
  // The state is `(yaw, pitch, dist, centre)`: azimuth and elevation in radians
  // about a point, and a distance from it. `dist` is the real distance and not a
  // multiplier, because the arithmetic needs a length; the CLI takes a multiple
  // of the auto-framed distance instead, so `--orbit 45,20,1.5` means the same
  // thing to every model regardless of its size.

  // atan2 AND NOT acos, and that is not a style choice: `acos` appears in the
  // compiler's builtin table and is NOT BOUND -- calling it is
  // `unbound variable: acos`. Asking the table said yes and asking by calling
  // said no. `sin`, `cos`, `atan2` and `sqrt` were each checked by calling, on
  // the interpreter and the C backend, and agree to the byte.
  let orbit_of = fn (eye: v3) -> fn (ctr: v3) ->
    let d = V3.sub eye ctr in
    let flat = sqrt (d.x * d.x + d.z * d.z) in
    (atan2 d.x d.z, atan2 d.y flat, V3.length d, ctr);

  // THE PITCH IS HELD JUST INSIDE VERTICAL -- 1.5697 rad, 89.94 degrees.
  //
  // AND NOT FOR THE REASON THAT LOOKED OBVIOUS. This first said the basis
  // degenerates at exactly +-90 degrees and the matrix fills with NaN, which is
  // what the geometry suggests: the view direction becomes parallel to the world
  // up `look_at` builds from. MEASURED, IT DOES NOT HAPPEN. `cos (pi/2)` in double
  // is 6.1e-17 rather than zero, so the direction is (1.2e-16, 4, 2.1e-16), the
  // cross product with up is tiny but non-zero, and the determinant comes out
  // -1.168056431889891 against -1.1680564318898945 a degree away. No NaN at pi/2,
  // and none anywhere, because no double pitch makes that cosine exactly zero.
  //
  // What the clamp actually prevents is a TUMBLE. Past vertical the cosine turns
  // negative, so the eye's horizontal offset flips sign and the camera swings over
  // the top to the opposite azimuth: at pitch 1.75 the eye is at
  // (-0.34, 3.94, -0.63) where at 1.40 it was at (+0.33, 3.94, +0.60). The view
  // inverts and a drag that was raising the camera starts lowering it down the far
  // side. That is a control that has stopped meaning anything, which is reason
  // enough -- and it is the reason, so it is the one written down.
  let pitch_limit = 1.5697;
  let clamp_pitch = fn (p: float) ->
    if p > pitch_limit then pitch_limit
    else if p < 0.0 - pitch_limit then 0.0 - pitch_limit
    else p;

  let orbit_camera = fn (o: (float * float * float * v3)) -> fn (tan_half: float) ->
                     fn (aspect: float) -> fn (znear: float) -> fn (zfar: float) ->
    let (yaw, pitch, dist, ctr) = o in
    let cp = cos pitch in
    let eye = V3.add ctr (v3 { x = dist * cp * sin yaw,
                               y = dist * sin pitch,
                               z = dist * cp * cos yaw }) in
    (eye, ctr, tan_half, znear, zfar,
     M4.mul (M4x.perspective_from_tan tan_half aspect znear zfar)
            (M4x.look_at eye ctr (v3 { x = 0.0, y = 1.0, z = 0.0 })));

  // The three interactions. Angles in radians, `k` a multiplier, pan in units of
  // the current distance so that dragging moves the model by the same fraction of
  // the frame however far away it is.
  let orbit_turn = fn (o: (float * float * float * v3)) -> fn (dyaw: float) -> fn (dpitch: float) ->
    let (yaw, pitch, dist, ctr) = o in
    (yaw + dyaw, clamp_pitch (pitch + dpitch), dist, ctr);

  // Clamped at both ends: without a floor, repeated zooming reaches 0 and the eye
  // sits exactly on the centre, where `look_at` has no direction to build a basis
  // from -- the same degeneracy as the pole, arrived at from the other side.
  let orbit_zoom = fn (o: (float * float * float * v3)) -> fn (k: float) ->
    let (yaw, pitch, dist, ctr) = o in
    let nd = dist * k in
    (yaw, pitch, if nd < 0.0001 then 0.0001 else if nd > 1000000.0 then 1000000.0 else nd, ctr);

  // Pan moves the CENTRE across the camera's own right and up, so the model
  // slides in the frame rather than swinging around a point that has not moved.
  // THE NEAR AND FAR PLANES HAVE TO FOLLOW THE DISTANCE, or zooming in clips the
  // model away and zooming out loses it behind the far plane. Both are recovered
  // from the auto camera's own numbers by algebra rather than by measuring the
  // scene again: it set `znear = dist * 0.01` and `zfar = dist + r * 4`, so
  // `r = (zfar - dist) / 4`. One source for the rule, so the orbiting camera and
  // the framed one cannot drift apart.
  let orbit_planes = fn (dist: float) -> fn (auto_dist: float) -> fn (auto_zfar: float) ->
    let r = (auto_zfar - auto_dist) * 0.25 in
    (dist * 0.01, dist + r * 4.0);

  // The whole camera, from an orbit state and the auto camera it started from.
  // Both entry points call this, so `--orbit` means the same thing to a file and
  // to a window.
  let orbit_framed = fn (o: (float * float * float * v3)) -> fn (aspect: float) ->
                     fn (auto: (v3 * v3 * float * float * float * mat4)) ->
    let (ae, ac, ath, _azn, azf, _avp) = auto in
    let (_y, _p, dist, _c) = o in
    let (zn, zf) = orbit_planes dist (V3.length (V3.sub ae ac)) azf in
    orbit_camera o ath aspect zn zf;

  // `--orbit yaw,pitch,dist`: DEGREES and a MULTIPLE of the auto-framed distance,
  // because those are the two things that mean the same for every model. Radians
  // would be unreadable on a command line and an absolute distance would frame
  // Suzanne and miss Fox entirely.
  let orbit_of_flag = fn (auto: (v3 * v3 * float * float * float * mat4)) ->
                      fn (yaw_deg: float) -> fn (pitch_deg: float) -> fn (dist_mult: float) ->
    let (ae, ac, _ath, _azn, _azf, _avp) = auto in
    let deg = 0.017453292519943295 in
    let (_y0, _p0, d0, _c0) = orbit_of ae ac in
    (yaw_deg * deg, clamp_pitch (pitch_deg * deg), d0 * dist_mult, ac);

  let orbit_pan = fn (o: (float * float * float * v3)) -> fn (dx: float) -> fn (dy: float) ->
    let (yaw, pitch, dist, ctr) = o in
    let (eye, _c, _t, _zn, _zf, _vp) = orbit_camera o 1.0 1.0 0.1 2.0 in
    let fwd = V3.normalize (V3.sub ctr eye) in
    let right = V3.normalize (V3.cross fwd (v3 { x = 0.0, y = 1.0, z = 0.0 })) in
    let up = V3.cross right fwd in
    let shift = V3.add (V3.scale right (dx * dist)) (V3.scale up (dy * dist)) in
    (yaw, pitch, dist, V3.add ctr shift);
}

module Render {
  // Vertex attributes, read once per primitive. A record cannot hold a Vec
  // (OPEN_QUESTIONS Q-8), so these travel as a tuple.
  let attr = fn (d: doc) -> fn (prim: Json.json) -> fn (name: str) ->
    match J.field (J.req prim "attributes") name with
    | None -> None
    | Some a -> Some (Acc.floats d (J.int_ a));

  // SKINNING: a vertex belongs to up to four joints, and lands where their
  // weighted average of transforms puts it.
  //
  // THE JOINT MATRICES, one per joint of a skin:
  //
  //     jointMatrix[j] = worldMatrix(joints[j]) * inverseBindMatrix[j]
  //
  // and the vertex is then `Σ weight_i * jointMatrix[joint_i] * position`.
  //
  // THE MESH NODE'S OWN TRANSFORM IS NOT APPLIED, and that is the whole thing to
  // get right. The specification writes the joint matrix with an
  // `inverse(globalTransform(meshNode))` in front of it and then multiplies the
  // result by `globalTransform(meshNode)` again -- the two cancel, which is why
  // every implementation says "ignore the node's transform" instead. Applying it
  // anyway transforms the model twice, and for `CesiumMan` (whose mesh node sits
  // under a rotation) that is a figure lying on its side at the wrong scale --
  // a picture, not an error.
  //
  // The inverse bind matrix is what takes a vertex OUT of the pose the mesh was
  // authored in and into the joint's own space. Without it the mesh is skinned
  // from wherever the joints happen to be, which folds it into a knot at the
  // origin.
  let joint_matrices = fn (d: doc) -> fn (worlds) -> fn (si: int) ->
    let sk = match J.at (J.req d.j "skins") si with
             | None -> fail ("gltf: no skin " ++ str_of_int si)
             | Some x -> x in
    let js = J.arr (J.req sk "joints") in
    let nj = J.len js in
    // `inverseBindMatrices` is optional and its absence means the identity --
    // which the specification says, and which is a real case: a mesh authored
    // in the same space its joints start in needs no correction.
    let ibm = match J.field sk "inverseBindMatrices" with
              | None -> None
              | Some a ->
                let f = Acc.floats d (J.int_ a) in
                let _ = if vec_len f != nj * 16
                        then fail ("gltf: a skin has " ++ str_of_int nj ++ " joints but "
                                   ++ str_of_int (vec_len f / 16) ++ " inverse bind matrices")
                        else () in
                Some f in
    let out = vec_new () in
    let rec go = fn (j: int) ->
      if j >= nj then out
      else
        let ni = match J.at (J.req sk "joints") j with
                 | None -> fail "gltf: a skin's joint list is shorter than it says"
                 | Some x -> J.int_ x in
        let _ = if ni < 0 || ni >= vec_len worlds
                then fail ("gltf: skin joint " ++ str_of_int j ++ " names node "
                           ++ str_of_int ni ++ ", which is not in the document")
                else () in
        let w = (vec_get worlds ni : mat4) in
        let m =
          match ibm with
          | None -> w
          | Some f ->
            // COLUMN-MAJOR, which is how glTF stores every matrix -- the same
            // layout `mat4` already uses, so this is a read and not a transpose.
            let g = fn (k: int) -> vec_get f (j * 16 + k) in
            M4.mul w (mat4 { c0 = v4 { x = g 0,  y = g 1,  z = g 2,  w = g 3 },
                             c1 = v4 { x = g 4,  y = g 5,  z = g 6,  w = g 7 },
                             c2 = v4 { x = g 8,  y = g 9,  z = g 10, w = g 11 },
                             c3 = v4 { x = g 12, y = g 13, z = g 14, w = g 15 } }) in
        let _ = vec_push out m in
        go (j + 1) in
    go 0;

  // The weighted sum of four joint matrices for one vertex. Componentwise: a
  // matrix sum, not a product, because the joints act in parallel on the same
  // vertex rather than in sequence.
  //
  // A WEIGHT OF ZERO MUST CONTRIBUTE NOTHING EVEN IF ITS JOINT INDEX IS
  // NONSENSE. glTF allows the unused slots of a JOINTS_0 to hold anything at all
  // when the matching weight is zero, so a reader that looks the joint up first
  // and multiplies by zero afterwards indexes out of bounds on a legal file.
  let skin_matrix = fn (jm) -> fn (joints) -> fn (weights) -> fn (k: int) ->
    let z = v4 { x = 0.0, y = 0.0, z = 0.0, w = 0.0 } in
    let acc = fn (a: v4) -> fn (b: v4) -> fn (t: float) ->
      v4 { x = a.x + b.x * t, y = a.y + b.y * t, z = a.z + b.z * t, w = a.w + b.w * t } in
    let rec go = fn (i: int) -> fn (m: mat4) ->
      if i >= 4 then m
      else
        let t = vec_get weights (4 * k + i) in
        if t == 0.0 then go (i + 1) m
        else
          let ji = vec_get joints (4 * k + i) in
          let _ = if ji < 0 || ji >= vec_len jm
                  then fail ("gltf: a vertex names joint " ++ str_of_int ji
                             ++ " and the skin has " ++ str_of_int (vec_len jm))
                  else () in
          let j = (vec_get jm ji : mat4) in
          go (i + 1) (mat4 { c0 = acc m.c0 j.c0 t, c1 = acc m.c1 j.c1 t,
                             c2 = acc m.c2 j.c2 t, c3 = acc m.c3 j.c3 t }) in
    go 0 (mat4 { c0 = z, c1 = z, c2 = z, c3 = z });

  // MORPH TARGETS: the base attribute plus a weighted sum of DISPLACEMENTS.
  //
  // A target is not an alternative shape, it is a DELTA -- `POSITION` in a target
  // is how far each vertex moves, not where it ends up. Treating them as absolute
  // positions collapses the mesh toward the origin, which looks like a scale bug.
  //
  // THE WEIGHTS COME FROM THE NODE IF IT HAS THEM AND FROM THE MESH OTHERWISE,
  // and that order is the specification's: a node's `weights` override the mesh's
  // so that two nodes can instance one mesh at two poses. Nothing in this corpus
  // uses the node form, which is exactly why it is written from the specification
  // rather than from what happens to be needed.
  //
  // Returned as a fresh Vec only when something actually moves. `AnimatedMorphCube`
  // and `MorphStressTest` carry targets and all-zero weights -- their animations
  // drive them -- so at rest they must be BYTE-IDENTICAL to the unmorphed mesh,
  // and the cheapest way to be sure of that is not to touch the array at all.
  let morph_weights = fn (d: doc) -> fn (nd: Json.json) -> fn (mesh: Json.json) ->
    let get = fn (o: Json.json) ->
      match J.field o "weights" with
      | None -> None
      | Some a ->
        let v = vec_new () in
        let rec go = fn (i: int) ->
          if i >= J.len (J.arr a) then v
          else let _ = vec_push v (match J.at a i with | None -> 0.0 | Some x -> J.flt x) in
               go (i + 1) in
        Some (go 0) in
    match get nd with | Some w -> Some w | None -> get mesh;

  // THE ANIMATION WINS OVER BOTH, and the order is the specification's: an
  // animated `weights` channel overrides the node's, which overrides the mesh's.
  //
  // This was the whole of SimpleMorph's disagreement. Its mesh says [0.5, 0.5]
  // and its animation says [1.0, 0.0] at t = 0, so the moment the reference was
  // told to play the clip, the two renderers were showing different shapes --
  // IoU 0.336 -- and m3d's frame had not changed by a byte. Making the reference
  // play an animation is what made THIS necessary.
  let morph_weights_at = fn (d: doc) -> fn (ni: int) -> fn (nd: Json.json) ->
                         fn (mesh: Json.json) -> fn (st) ->
    let (_t, _r, _s, _m, woff, wcnt, wval) = st in
    if ni >= 0 && ni < vec_len woff && vec_get woff ni >= 0 then
      let base = vec_get woff ni in
      let cnt = vec_get wcnt ni in
      let v = vec_new () in
      let rec go = fn (i: int) ->
        if i >= cnt then v
        else let _ = vec_push v (vec_get wval (base + i)) in go (i + 1) in
      Some (go 0)
    else morph_weights d nd mesh;

  // `base` with each target's displacement added, scaled by its weight. `ncomp` is
  // 3 for POSITION and NORMAL; a target's array is the same shape as the base's.
  let morphed = fn (d: doc) -> fn (prim: Json.json) -> fn (name: str) ->
                fn (ws) -> fn (base) ->
    match J.field prim "targets" with
    | None -> base
    | Some ts ->
      match ws with
      | None -> base
      | Some w ->
        let n = J.len (J.arr ts) in
        // Nothing moves, so nothing is copied.
        let rec any = fn (i: int) ->
          if i >= n then false
          else if i < vec_len w && vec_get w i != 0.0 then true
          else any (i + 1) in
        if not (any 0) then base
        else
          let out = vec_new () in
          let rec copy = fn (i: int) ->
            if i >= vec_len base then () else let _ = vec_push out (vec_get base i) in copy (i + 1) in
          let _ = copy 0 in
          let rec tgt = fn (i: int) ->
            if i >= n then out
            else
              let wi = if i < vec_len w then vec_get w i else 0.0 in
              if wi == 0.0 then tgt (i + 1)
              else
                match J.at ts i with
                | None -> tgt (i + 1)
                | Some t ->
                  match J.field t name with
                  | None -> tgt (i + 1)
                  | Some a ->
                    let dv = Acc.floats d (J.int_ a) in
                    let _ =
                      if vec_len dv != vec_len base
                      then fail ("gltf: morph target " ++ str_of_int i ++ "'s " ++ name
                                 ++ " has " ++ str_of_int (vec_len dv) ++ " values where the base has "
                                 ++ str_of_int (vec_len base))
                      else () in
                    let rec add = fn (k: int) ->
                      if k >= vec_len dv then ()
                      else let _ = vec_set out k (vec_get out k + wi * vec_get dv k) in add (k + 1) in
                    let _ = add 0 in
                    tgt (i + 1) in
          tgt 0;

  // The indices, or 0..count-1 when the primitive has none. Making the
  // un-indexed case produce the same shape means the draw loop has one path
  // rather than two, and TriangleWithoutIndices is in the corpus precisely to
  // catch a renderer that only has the other.
  let indices = fn (d: doc) -> fn (prim: Json.json) -> fn (vcount: int) ->
    match J.field prim "indices" with
    | Some a -> Acc.ints d (J.int_ a)
    | None ->
      let v = vec_new () in
      let rec go = fn (i: int) -> if i == vcount then () else let _ = vec_push v i in go (i + 1) in
      let _ = go 0 in v;

  // A material's factors. Textures are read by the caller, which owns the
  // decoded images; this is only the numbers.
  let material_of = fn (d: doc) -> fn (prim: Json.json) ->
    let dflt = material { br = 1.0, bg = 1.0, bb = 1.0, ba = 1.0, metallic = 1.0,
                          roughness = 1.0, er = 0.0, eg = 0.0, eb = 0.0,
                          alpha_mode = 0, cutoff = 0.5, double_sided = false } in
    match J.field prim "material" with
    | None -> dflt
    | Some mi ->
      let m = match J.at (J.req d.j "materials") (J.int_ mi) with
              | None -> fail "gltf: primitive names a material that is not there"
              | Some x -> x in
      let pbr = match J.field m "pbrMetallicRoughness" with
                | None -> Json.JObj Nil | Some x -> x in
      let bc = match J.field pbr "baseColorFactor" with
               | None -> (1.0, 1.0, 1.0, 1.0)
               | Some a ->
                 let g = fn (i: int) -> match J.at a i with | None -> 1.0 | Some x -> J.flt x in
                 (g 0, g 1, g 2, g 3) in
      let (br, bg, bb, ba) = bc in
      let em = match J.field m "emissiveFactor" with
               | None -> (0.0, 0.0, 0.0)
               | Some a ->
                 let g = fn (i: int) -> match J.at a i with | None -> 0.0 | Some x -> J.flt x in
                 (g 0, g 1, g 2) in
      let (er, eg, eb) = em in
      let mode = let s = J.str_or m "alphaMode" "OPAQUE" in
                 if str_eq s "MASK" then 1 else if str_eq s "BLEND" then 2 else 0 in
      material { br = br, bg = bg, bb = bb, ba = ba,
                 metallic = J.flt_or pbr "metallicFactor" 1.0,
                 roughness = J.flt_or pbr "roughnessFactor" 1.0,
                 er = er, eg = eg, eb = eb,
                 alpha_mode = mode, cutoff = J.flt_or m "alphaCutoff" 0.5,
                 double_sided = J.bool_or m "doubleSided" false };

  // One texture slot of a primitive's material, decoded, or None when the
  // material does not use it.
  //
  // THE IMAGE IS DECODED HERE, ONCE PER SLOT PER PRIMITIVE PER FRAME. Two
  // primitives sharing one texture decode it twice, and a second frame decodes
  // everything again. That is wrong for anything animated and invisible for a
  // still, and the fix is a cache keyed on the image index -- owed, and named
  // here rather than discovered by someone timing a viewer.
  //
  // Everything this cannot do is REFUSED BY NAME. Silently rendering the
  // material's factor instead is what this renderer did before it had textures
  // at all, and the result was a white duck that no gate objected to: the
  // silhouette was right, the lighting was right, and the model was simply the
  // wrong colour. Only a second renderer looking at the same file caught it.
  //
  // `where` is the JSON object holding the slot -- `pbrMetallicRoughness` for
  // baseColor and metallicRoughness, the material itself for the other three.
  // A DECODED-IMAGE CACHE, INDEXED BY glTF IMAGE INDEX.
  //
  // `slot_tex` used to decode its image every time it was called, and `mat_slots`
  // is called PER PRIMITIVE -- so N primitives sharing a material decoded the same
  // PNG N times, every frame. In a still render that is waste; in a frame loop it
  // is unbounded growth, and it is what bench_check.sh's peak-RSS assertion caught
  // on its first run: forty frames of Suzanne took 4198 MB against 382 MB for one.
  //
  // KEYED ON THE IMAGE AND NOT THE TEXTURE, because the expensive part is the
  // decode and that depends only on the image. Wrap modes and the coordinate set
  // are cheap JSON reads and stay per-slot, which they have to: MultiUVTest points
  // two slots with different `texCoord` at the same image.
  //
  // WHY THE CALLER OWNS IT. A `texture` holds a `ByteBuf[R]`, so one decoded inside
  // a region cannot be stored anywhere that outlives the region -- Mere rejects
  // that outright. A cache that is to survive across frames therefore has to be
  // created, and filled, outside them. `one_frame_cam` makes a fresh one per call
  // so every existing caller is unchanged; a frame loop makes one and keeps it.
  let tex_cache = fn (d: doc) ->
    let n = match J.field d.j "images" with
            | None -> 0
            | Some ij -> J.arr_len ij in
    let v = vec_new () in
    let rec fill = fn (i: int) ->
      if i >= n then v
      else
        let _ = vec_push v (None : texture option) in
        fill (i + 1) in
    fill 0;

  // THE LOOKUP NEVER WRITES, and that is a structural requirement rather than
  // tidiness. A `texture` holds a `ByteBuf[R]`; if this function could store one,
  // then calling it from inside a `region` would mean storing a region-allocated
  // value into a Vec that outlives the region, and Mere rejects that AT COMPILE
  // TIME -- on the code path existing, not on it being taken. So a frame loop could
  // not wrap its frames in a region at all. Filling is `warm_cache` below, which
  // the caller runs once, outside.
  //
  // A miss decodes and does not store. That keeps this total, and the still path
  // warms the cache first so a miss there means the image was not reachable from
  // any material -- in which case decoding it once is exactly the old behaviour.
  let cached_image = fn (d: doc) -> fn (cache) -> fn (si: int) ->
    if si < 0 || si >= vec_len cache then
      Tex.of_bytes (Gltf.image d si) (Gltf.image_name d si)
    else
      match (vec_get cache si : texture option) with
      | Some t -> t
      | None -> Tex.of_bytes (Gltf.image d si) (Gltf.image_name d si);

  // Decode every image A MATERIAL CAN REACH, and no others.
  //
  // Not "every image in the document", which would be simpler and would change
  // which files load: an unused image that this decoder refuses -- a progressive
  // JPEG, say -- would start failing a document that renders fine today. The set
  // here is exactly the set `mat_slots` asks for, because it runs for every
  // primitive regardless of what ends up visible.
  let warm_cache = fn (d: doc) -> fn (cache) ->
    let src_of = fn (ti: int) ->
      match J.at (J.req d.j "textures") ti with
      | None -> 0 - 1
      | Some tx -> match J.field tx "source" with
                   | None -> 0 - 1
                   | Some sj -> J.int_ sj in
    let want = fn (holder: Json.json) -> fn (slot: str) ->
      match J.field holder slot with
      | None -> ()
      | Some sj ->
        let si = src_of (J.int_ (J.req sj "index")) in
        if si < 0 || si >= vec_len cache then ()
        else
          match (vec_get cache si : texture option) with
          | Some _ -> ()
          | None -> vec_set cache si
                      (Some (Tex.of_bytes (Gltf.image d si) (Gltf.image_name d si))) in
    let rec mats = fn (xs) ->
      match xs with
      | Nil -> ()
      | Cons (m, rest) ->
        let pbr = match J.field m "pbrMetallicRoughness" with
                  | None -> Json.JObj Nil | Some x -> x in
        let _ = want pbr "baseColorTexture" in
        let _ = want pbr "metallicRoughnessTexture" in
        let _ = want m "normalTexture" in
        let _ = want m "occlusionTexture" in
        let _ = want m "emissiveTexture" in
        mats rest in
    match J.field d.j "materials" with
    | None -> ()
    | Some mj -> mats (J.arr mj);

  let slot_tex = fn (d: doc) -> fn (cache) -> fn (holder: Json.json) -> fn (slot: str) ->
    match J.field holder slot with
    | None -> None
    | Some sj ->
      let uvset = J.int_or sj "texCoord" 0 in
      // Only TEXCOORD_0 and TEXCOORD_1 are carried through the rasterizer, so a
      // slot pointing at a third set would silently sample the wrong one.
      let _ = if uvset > 1
              then fail ("gltf: " ++ slot ++ " uses TEXCOORD_" ++ str_of_int uvset
                         ++ ", and this renderer carries only 0 and 1")
              else () in
      let ti = J.int_ (J.req sj "index") in
      let tx = match J.at (J.req d.j "textures") ti with
               | None -> fail ("gltf: no texture " ++ str_of_int ti)
               | Some x -> x in
      let si = J.int_ (J.req tx "source") in
      // A sampler is optional; glTF leaves the defaults to the runtime, and
      // these are the ones three.js and every other viewer picked: repeat,
      // and linear magnification.
      let (ws, wt, mag) =
        match J.field tx "sampler" with
        | None -> (Wrap.repeat_, Wrap.repeat_, 9729)
        | Some sjx ->
          match J.at (J.req d.j "samplers") (J.int_ sjx) with
          | None -> fail "gltf: texture names a sampler that is not there"
          | Some sm -> (J.int_or sm "wrapS" Wrap.repeat_,
                        J.int_or sm "wrapT" Wrap.repeat_,
                        J.int_or sm "magFilter" 9729) in
      // MINIFICATION IS NOT IMPLEMENTED. `minFilter` is read and ignored:
      // there are no mipmaps, so a texture squeezed into fewer pixels than it
      // has texels is point-or-bilinear sampled at full resolution and
      // aliases. It is the largest remaining disagreement with the reference
      // renderer on the textured models, and it is recorded there rather than
      // hidden.
      Some (texslot { img = cached_image d cache si,
                      ws = ws, wt = wt, mag = mag, uvset = uvset });

  // Sampling a slot: the colour space and the coordinate set are both properties
  // OF THE SLOT rather than of the file or the mesh.
  //
  // glTF says baseColor and emissive are sRGB-encoded and that
  // metallicRoughness, occlusion and normal are not. Decoding a roughness map
  // through the transfer curve makes every surface smoother than the file says,
  // everywhere, and reads as a lighting choice rather than as a bug -- so
  // `srgb` is a parameter with no default and the caller states it per slot.
  //
  // Neither path puts a pixel through `pow`: the sRGB decode is a table lookup,
  // which is what keeps the four backends bit-identical through all of this.
  //
  // WRITTEN HERE RATHER THAN INSIDE THE SHADER, and that is not a style
  // preference: as a closure nested in the per-pixel one it captured the shader's
  // parameters, and the C backend lifted it to a function whose argument list
  // named locals the call site did not have -- `use of undeclared identifier
  // 'mu_fw'`, on 95 KB of emitted C. At module level it captures nothing. The
  // compiler bug is real and filed; this shape does not depend on it.
  let slot_sample = fn (ts: texslot) -> fn (srgb: bool) ->
                    fn (u: float) -> fn (v: float) -> fn (u1: float) -> fn (v1: float) ->
    let su = if ts.uvset == 1 then u1 else u in
    let sv = if ts.uvset == 1 then v1 else v in
    if ts.mag == 9728 then
      let (a, b, c, e) = Tex.nearest ts.img ts.ws ts.wt su sv in
      let f = fn (x: int) -> if srgb then Srgb.decode x else float_of_int x / 255.0 in
      v4 { x = f a, y = f b, z = f c, w = float_of_int e / 255.0 }
    else if srgb then Tex.sample_srgb ts.img ts.ws ts.wt su sv
    else Tex.sample_linear ts.img ts.ws ts.wt su sv;

  // `occlusionTexture.strength`, which scales how far the map may darken: the
  // specification's own formula is 1 + strength * (sampled - 1), so a strength of
  // 0 disables the map and 1 applies it whole. Defaults to 1.
  let occ_str = fn (d: doc) -> fn (prim: Json.json) ->
    match J.field prim "material" with
    | None -> 1.0
    | Some mi ->
      match J.at (J.req d.j "materials") (J.int_ mi) with
      | None -> 1.0
      | Some m ->
        match J.field m "occlusionTexture" with
        | None -> 1.0
        | Some oj -> J.flt_or oj "strength" 1.0;

  // `normalTexture.scale`, which multiplies the map's X and Y and leaves Z alone.
  // Defaults to 1. Every model in this corpus uses 1, so nothing here exercises
  // it and there is a property instead.
  let nrm_scale = fn (d: doc) -> fn (prim: Json.json) ->
    match J.field prim "material" with
    | None -> 1.0
    | Some mi ->
      match J.at (J.req d.j "materials") (J.int_ mi) with
      | None -> 1.0
      | Some m ->
        match J.field m "normalTexture" with
        | None -> 1.0
        | Some nj -> J.flt_or nj "scale" 1.0;

  // The five slots glTF's metallic-roughness material has. `pbr` and the
  // material are two different holders and the specification puts particular
  // slots in each; getting that wrong finds nothing, because a slot looked for
  // in the wrong object is simply absent.
  let mat_slots = fn (d: doc) -> fn (cache) -> fn (prim: Json.json) ->
    match J.field prim "material" with
    | None -> (None, None, None, None, None)
    | Some mi ->
      let m = match J.at (J.req d.j "materials") (J.int_ mi) with
              | None -> fail "gltf: primitive names a material that is not there"
              | Some x -> x in
      let pbr = match J.field m "pbrMetallicRoughness" with
                | None -> Json.JObj Nil | Some x -> x in
      (slot_tex d cache pbr "baseColorTexture",
       slot_tex d cache pbr "metallicRoughnessTexture",
       slot_tex d cache m "normalTexture",
       slot_tex d cache m "occlusionTexture",
       slot_tex d cache m "emissiveTexture");

  // SHADING IS PER VERTEX HERE, and that is a first slice rather than the
  // answer. The rasterizer interpolates a colour, so a normal cannot reach the
  // pixel; a sphere lit this way shows its triangles at the silhouette and its
  // specular highlight lands on a vertex or misses entirely. Per-pixel shading
  // needs the rasterizer to carry a normal and a texture coordinate through the
  // same perspective-correct interpolation the colour already gets, which is a
  // change to raster.mere and is the next slice. Said here rather than left for
  // a reader to notice in the output.
  // `lit` off means the directional light is black: ambient and emissive only.
  // It exists for the north-star gate, which needs to ask "is this brighter than
  // ambient alone" PER MODEL rather than against a threshold -- glTF's default
  // material is fully metallic, so its ambient is zero and any fixed threshold
  // either passes a black render or fails a correct metal.
  // The background is a PARAMETER, and that is not a preference.
  //
  // Anything comparing this renderer's output with another's has to decide which
  // pixels the model covers, and with a dark grey background a dark surface is
  // indistinguishable from no surface. It showed up as Suzanne -- a dense, dark
  // mesh -- reading 0.92 on a silhouette measure that had nothing wrong with the
  // geometry: parts of it landed within a few levels of the clear colour and
  // stopped counting as covered. Adding a texture slot moved the number, which is
  // the tell that a SILHOUETTE measure was answering a COLOUR question.
  //
  // So a gate can ask for a background no plausible surface lands on. A saturated
  // magenta is not proof -- a magenta emissive surface would still fool it -- and
  // the only exact answer is to render twice on two backgrounds and take the
  // pixels that stay put. That costs a second render on both sides and is not
  // paid for yet; this is written down rather than assumed away.
  // ONE FRAME WITH A CAMERA SOMEBODY ELSE CHOSE. `one_frame_anim` below frames the
  // scene itself, which is what a still-image renderer wants and what an orbiting
  // window cannot use: the camera has to survive from one frame to the next and be
  // driven by a mouse. So the body lives here, taking the camera as
  // `(eye, center, tan_half_yfov, znear, zfar, view_projection)` -- the same 6-tuple
  // `Frame.auto_camera_at` returns, so handing it that output unchanged must give
  // back exactly the frame `one_frame_anim` gives. A property asserts that, byte for
  // byte, because it is the only thing that says this extraction moved nothing.
  let one_frame_cached = fn (d: doc) -> fn (w: int) -> fn (h: int) -> fn (lit: bool) ->
                      fn (bg: v3) -> fn (time: float) -> fn (anim: int) ->
                      fn (cam: (v3 * v3 * float * float * float * mat4)) -> fn (cache) ->
    let (t, depth) = Target.make w h in
    let _ = Target.clear t depth (int_of_float bg.x) (int_of_float bg.y) (int_of_float bg.z) in
    let ast = Scene.anim_state_of d time anim in
    let (eye, ctr, th, zn, zf, vp) = cam in
    let k = if lit then 3.0 else 0.0 in
    let light = dirlight { dx = 0.0 - 0.4, dy = 0.0 - 0.7, dz = 0.0 - 0.6, lr = k, lg = k, lb = k } in
    let fw = float_of_int w in
    let fh = float_of_int h in
    let drawn = vec_new () in
    let _ = vec_push drawn 0 in
    let _ = Scene.walk_at d ast (fn (ni: int) -> fn (nd: Json.json) -> fn (world: mat4) ->
      match J.field nd "mesh" with
      | None -> ()
      | Some mi ->
        let mesh = match J.at (J.req d.j "meshes") (J.int_ mi) with
                   | None -> fail "gltf: node names a mesh that is not there" | Some x -> x in
        let mweights = morph_weights_at d ni nd mesh ast in
        // A SKINNED NODE'S OWN TRANSFORM IS REPLACED, NOT COMBINED. The joint
        // matrices already carry the vertex all the way to world space, so
        // `world` must not be applied on top of them -- see `joint_matrices`.
        let skin = match J.field nd "skin" with
                   | None -> None
                   | Some si -> Some (joint_matrices d (Scene.world_matrices_at d ast) (J.int_ si)) in
        let nrm_m = match M4x.normal_matrix world with | None -> M4.identity | Some x -> x in
        // A mirroring transform reverses the winding order (glTF 3.7.4). Decided
        // per node, once, from the global transform's determinant.
        let flip = M4x.determinant world < 0.0 in
        let rec prims = fn (xs) ->
          match xs with
          | Nil -> ()
          | Cons (prim, rest) ->
            // POINTS, the three LINE modes, and TRIANGLES. TRIANGLE_STRIP and
            // TRIANGLE_FAN change how triangles are ASSEMBLED from the indices,
            // and nothing in the corpus uses either, so writing them would be
            // guessing -- they are REFUSED BY NAME instead of skipped, which is
            // what this used to do for every non-triangle mode.
            let _ =
              let pmode = J.int_or prim "mode" 4 in
              if pmode == 5 || pmode == 6 then
                fail ("gltf: primitive mode " ++ str_of_int pmode
                      ++ (if pmode == 5 then " (TRIANGLE_STRIP)" else " (TRIANGLE_FAN)")
                      ++ " is not implemented -- no model in this corpus uses one, so it "
                      ++ "would be written blind")
              else
                match attr d prim "POSITION" with
                | None -> ()
                | Some pos0 ->
                  // MORPHED BEFORE ANYTHING ELSE TOUCHES THEM. Everything
                  // downstream -- the face normal, the bounds, the projection --
                  // has to see the moved vertex, so this is the first thing done
                  // with the arrays and not a correction applied later.
                  let pos = morphed d prim "POSITION" mweights pos0 in
                  let nrm = match attr d prim "NORMAL" with
                            | None -> None
                            | Some n0 -> Some (morphed d prim "NORMAL" mweights n0) in
                  let mat = material_of d prim in
                  let occ_strength = occ_str d prim in
                  let (btex, mrtex, nmtex, octex, emtex) = mat_slots d cache prim in
                  let vcount = vec_len pos / 3 in
                  let idx = indices d prim vcount in
                  let tri = vec_len idx / 3 in
                  // JOINTS_0 is read as INTEGERS, not floats: it is an index and
                  // a float would be a conversion nobody asked for. WEIGHTS_0 may
                  // be `normalized` bytes or shorts, which `Acc.floats` already
                  // scales to 0..1.
                  let sjoints = match J.field (J.req prim "attributes") "JOINTS_0" with
                                | None -> None | Some a -> Some (Acc.ints d (J.int_ a)) in
                  let sweights = attr d prim "WEIGHTS_0" in
                  // TANGENT is VEC4: xyz is the tangent and W IS A HANDEDNESS,
                  // +1 or -1, saying which way the bitangent goes. It is not a
                  // fourth coordinate and normalizing the four together would
                  // destroy it -- which is what NormalTangentMirrorTest exists
                  // to catch, its two halves differing only in that sign.
                  let tang = match J.field (J.req prim "attributes") "TANGENT" with
                             | None -> None | Some a -> Some (Acc.floats d (J.int_ a)) in
                  let uv = attr d prim "TEXCOORD_0" in
                  let uv1 = attr d prim "TEXCOORD_1" in
                  let col0 = attr d prim "COLOR_0" in
                  let col0_n = match J.field (J.req prim "attributes") "COLOR_0" with
                               | None -> 3
                               | Some a ->
                                 let acc = match J.at (J.req d.j "accessors") (J.int_ a) with
                                           | None -> fail "gltf: no such accessor" | Some x -> x in
                                 Acc.n_comp (J.str_ (J.req acc "type")) in
                  // A vertex's world position, and its normal when the file has
                  // one. The normal is deliberately NOT defaulted here: glTF says
                  // a primitive with no NORMAL is FLAT SHADED, and a flat normal
                  // is a property of the triangle rather than of the vertex, so
                  // it cannot be decided until all three are in hand.
                  // The matrix that takes vertex `k` to world space: the node's
                  // own when the mesh is not skinned, and the vertex's own blend
                  // of joint matrices when it is.
                  let vmat = fn (k: int) ->
                    match skin with
                    | None -> world
                    | Some jm ->
                      match sjoints with
                      | None -> world
                      | Some js ->
                        match sweights with
                        | None -> world
                        | Some ws -> skin_matrix jm js ws k in
                  let wpos = fn (k: int) ->
                    V4.xyz (M4.mul_point (vmat k)
                      (v3 { x = vec_get pos (3 * k), y = vec_get pos (3 * k + 1),
                            z = vec_get pos (3 * k + 2) })) in
                  let vnorm = fn (k: int) ->
                    match nrm with
                    | None -> None
                    | Some nv ->
                      let n0 = v3 { x = vec_get nv (3 * k), y = vec_get nv (3 * k + 1),
                                    z = vec_get nv (3 * k + 2) } in
                      // THE SKIN MATRIX ITSELF, not its inverse transpose. A
                      // normal wants the inverse transpose in general, and three.js
                      // uses the skin matrix directly here -- so this matches the
                      // reference renderer rather than the textbook, and says so.
                      // It differs only under non-uniform joint scale, which none
                      // of the corpus's rigs have.
                      match skin with
                      | None -> Some (V3.normalize (M4.mul_dir nrm_m n0))
                      | Some _ -> Some (V3.normalize (M4.mul_dir (vmat k) n0)) in
                  // The tangent and bitangent of vertex `k`, in world space.
                  // The bitangent is CONSTRUCTED, not stored: glTF gives a
                  // handedness rather than a vector, and cross(N, T) * w is what
                  // that handedness means.
                  let vtan = fn (k: int) -> fn (n: v3) ->
                    match tang with
                    | None -> None
                    | Some tv ->
                      // NOT NAMED `t`. The render target is bound as `t` in
                      // `one_frame_bg`, and the C backend's closure lifting gave
                      // the OUTER one this local's type in the lifted signature:
                      // `passing 'target' to parameter of incompatible type 'v3'`.
                      // Two levels of lifting and a shadowed name -- the family
                      // recorded as Q-126, and this is the first shape of it small
                      // enough to point at.
                      let tg = V3.normalize (M4.mul_dir (vmat k)
                                (v3 { x = vec_get tv (4 * k), y = vec_get tv (4 * k + 1),
                                      z = vec_get tv (4 * k + 2) })) in
                      let hand = vec_get tv (4 * k + 3) in
                      Some (tg, V3.scale (V3.cross n tg) hand) in
                  let vuv = fn (k: int) ->
                    match uv with
                    | None -> (0.0, 0.0)
                    | Some t2 -> (vec_get t2 (2 * k), vec_get t2 (2 * k + 1)) in
                  let vuv1 = fn (k: int) ->
                    match uv1 with
                    | None -> (0.0, 0.0)
                    | Some t2 -> (vec_get t2 (2 * k), vec_get t2 (2 * k + 1)) in
                  // COLOR_0 is VEC3 or VEC4 and MULTIPLIES the base colour; the
                  // stride differs between the two and reading a VEC4 as a VEC3
                  // walks off by one vertex per vertex.
                  let vcol = fn (k: int) ->
                    match col0 with
                    | None -> (1.0, 1.0, 1.0)
                    | Some cv ->
                      let o = col0_n * k in
                      (vec_get cv o, vec_get cv (o + 1), vec_get cv (o + 2)) in
                  // PER PIXEL. The shader is called at every covered pixel with
                  // the interpolated, re-normalized normal -- so a highlight
                  // lands where the surface points at the light rather than
                  // where a vertex happens to be.
                  let has_tangent = match tang with | Some _ -> true | None -> false in
                  let nm_scale = nrm_scale d prim in
                  let shader = fn (wp: v3) -> fn (n0: v3) -> fn (u: float) -> fn (vv: float) ->
                               fn (u1: float) -> fn (vv1: float) ->
                               fn (fa: v3) -> fn (fb: v3) -> fn (vc: v3) ->
                    let sample_s = fn (ts: texslot) -> slot_sample ts true u vv u1 vv1 in
                    let sample_l = fn (ts: texslot) -> slot_sample ts false u vv u1 vv1 in
                    // baseColor is factor * vertex colour * texture, all three
                    // multiplied in LINEAR light.
                    let tc = match btex with
                             | None -> v4 { x = 1.0, y = 1.0, z = 1.0, w = 1.0 }
                             | Some ts -> sample_s ts in
                    // metallicRoughness packs TWO CHANNELS OF ONE IMAGE:
                    // ROUGHNESS IN GREEN, METALLIC IN BLUE. Not red and green --
                    // that ordering is a different format's, it produces a
                    // plausible picture, and red here is unused and often zero,
                    // which would make everything a perfect mirror.
                    let mr = match mrtex with
                             | None -> v4 { x = 1.0, y = 1.0, z = 1.0, w = 1.0 }
                             | Some ts -> sample_l ts in
                    // Occlusion multiplies the AMBIENT TERM ONLY, and its
                    // strength defaults to 1. It stands for light that never
                    // arrived from the environment; applying it to the
                    // directional light would darken a surface the light can
                    // plainly see, which is the mistake that makes creases look
                    // painted on.
                    let occ = match octex with
                              | None -> 1.0
                              | Some ts -> 1.0 + occ_strength * ((sample_l ts).x - 1.0) in
                    // Emissive is sRGB-encoded and MULTIPLIES the factor, which
                    // defaults to zero -- so a model with an emissive texture and
                    // no emissiveFactor emits nothing, and that is the
                    // specification rather than an oversight.
                    let em = match emtex with
                             | None -> v3 { x = 1.0, y = 1.0, z = 1.0 }
                             | Some ts -> let c = sample_s ts in
                                          v3 { x = c.x, y = c.y, z = c.z } in
                    // THE SHADING NORMAL, perturbed by the normal map.
                    //
                    // The map is sampled LINEARLY: a normal is a direction, not a
                    // colour, and putting it through the sRGB curve is the classic
                    // mistake -- subtly wrong everywhere and obviously wrong
                    // nowhere. `Tex.sample_linear` is a separate name from
                    // `sample_srgb` for exactly this reason.
                    //
                    // `texel * 2 - 1` because a normal component runs -1..1 and a
                    // byte runs 0..1. `scale` multiplies X AND Y ONLY -- glTF says
                    // so, and it is what makes a scale of 0 flatten the surface
                    // rather than zero the normal.
                    // ONLY WHERE THE FILE SUPPLIES TANGENTS, for now.
                    //
                    // glTF says a renderer SHOULD derive a tangent frame from the
                    // texture coordinates when TANGENT is absent, and the code
                    // below can do it -- `fa` and `fb` are computed for that case
                    // and the frame is their cross with the pixel's normal. IT IS
                    // NOT RIGHT YET, measured: against the reference it makes
                    // NormalTangentTest worse (4.26 to 5.25) while making
                    // CompareNormal better (5.72 to 4.37), which is not the
                    // signature of a sign error or of a working implementation.
                    //
                    // What went wrong is HOW IT WAS DEBUGGED, not just the maths:
                    // a corpus-wide mean is the weakest possible instrument for a
                    // per-pixel frame, and two rounds of adjusting a sign against
                    // it moved three numbers in three directions. The next step is
                    // a purpose-built input -- one flat quad, a known map, a known
                    // UV layout, an answer computable by hand -- and not more
                    // tuning against an aggregate.
                    //
                    // So the three models without tangents keep the numbers they
                    // had, and that is stated rather than pinned as progress.
                    let n =
                      match nmtex with
                      | None -> n0
                      // ONLY WHERE THE FILE SUPPLIES TANGENTS.
                      //
                      // The derived path below is written, and it is verified only
                      // against ITSELF: the property in test/render_props.mere shows
                      // that on a quad with axis-aligned UVs the derived frame
                      // equals the SUPPLIED one -- m3d against m3d, which is
                      // self-consistency and not an oracle.
                      //
                      // Against the oracle it is worse on all three corpus models
                      // that need it: NormalTangentTest 4.26 to 4.66, CompareNormal
                      // 5.72 to 8.10, Box With Spaces 0.26 to 0.41. So it stays off.
                      //
                      // THERE MAY BE NO SINGLE RIGHT ANSWER HERE. glTF says to use
                      // MikkTSpace when TANGENT is absent; three.js uses per-pixel
                      // SCREEN-SPACE DERIVATIVES; this computes per-triangle affine
                      // gradients. Three algorithms, and agreement between any two
                      // of them is not conformance to the third. Establishing which
                      // to aim at needs an instrument that sees THE FRAME rather
                      // than the picture -- the picture is a lossy view of it, and
                      // two rounds of adjusting a sign against a corpus-wide mean
                      // moved three numbers in three directions.
                      | Some ts -> if not has_tangent then n0 else
                        let c = slot_sample ts false u vv u1 vv1 in
                        let mx = (c.x * 2.0 - 1.0) * nm_scale in
                        let my = (c.y * 2.0 - 1.0) * nm_scale in
                        let mz = c.z * 2.0 - 1.0 in
                        // TWO WAYS TO THE SAME FRAME, and which one is the
                        // primitive's business. With TANGENT, `fa` and `fb` are the
                        // interpolated tangent and bitangent and want re-normalizing
                        // -- interpolating two unit vectors gives short ones.
                        // Without, they are the derived pair and the frame is their
                        // cross with THIS PIXEL'S normal, which is what makes it
                        // correct on a curved mesh: a cross product with N is
                        // perpendicular to N by construction.
                        // NOT `t` AND `b`. Naming the tangent `t` here made the
                        // C backend's closure lifting give the OUTER `t` -- the
                        // render target, bound in `one_frame_bg` -- this local's
                        // type in the lifted signature: `passing 'target' to
                        // parameter of incompatible type 'v3'`. A shadowed name
                        // across two levels of lifting, which is the family
                        // recorded as Q-126.
                        let (tan_v, bit_v) =
                          if has_tangent then (V3.normalize fa, V3.normalize fb)
                          else
                            let t0 = V3.cross fa n0 in
                            let b0 = V3.cross fb n0 in
                            // ONE SHARED SCALE, not two normalizations: the ratio
                            // of |T| to |B| is a property of the texture
                            // coordinates and dividing each by its own length
                            // would throw it away. three.js takes the larger of
                            // the two, and so does this.
                            let d2 = f_max (V3.dot t0 t0) (V3.dot b0 b0) in
                            if d2 <= 0.0 then (t0, b0)
                            else let sc = 1.0 / sqrt d2 in
                                 (V3.scale t0 sc, V3.scale b0 sc) in
                        let nn = V3.add (V3.add (V3.scale tan_v mx) (V3.scale bit_v my))
                                        (V3.scale n0 mz) in
                        if V3.dot nn nn <= 0.0 then n0 else V3.normalize nn in
                    let mat2 = material { br = mat.br * vc.x * tc.x, bg = mat.bg * vc.y * tc.y,
                                          bb = mat.bb * vc.z * tc.z, ba = mat.ba * tc.w,
                                          metallic = mat.metallic * mr.z,
                                          roughness = mat.roughness * mr.y,
                                          er = mat.er * em.x, eg = mat.eg * em.y,
                                          eb = mat.eb * em.z,
                                          alpha_mode = mat.alpha_mode, cutoff = mat.cutoff,
                                          double_sided = mat.double_sided } in
                    // MASK IS A COVERAGE DECISION AND IT BELONGS HERE, after the
                    // texture: the alpha it tests is the factor times the sampled
                    // texel, so it cannot be decided per vertex or per primitive.
                    //
                    // `Shade.passes_alpha` was written and property-tested and had
                    // NO CALLER -- the second time this project found a complete,
                    // tested module that nothing used, and the second time a
                    // reference renderer was what noticed. Two models drew their
                    // masked-out labels as solid rectangles and every gate here
                    // was green.
                    if not (Shade.passes_alpha mat2 mat2.ba) then None
                    else
                      let vdir = V3.normalize (V3.sub eye wp) in
                      Some (V3.add (V3.add (Shade.direct mat2 n vdir light)
                                           (Shade.ambient mat2 (0.15 * occ)))
                                   (Shade.emissive mat2)) in
                  let rec go = fn (ti: int) ->
                    if ti == tri then ()
                    else
                      let k0 = vec_get idx (3 * ti) in
                      let k1 = vec_get idx (3 * ti + 1) in
                      let k2 = vec_get idx (3 * ti + 2) in
                      let w0 = wpos k0 in let w1 = wpos k1 in let w2 = wpos k2 in
                      // NO NORMAL MEANS FLAT SHADED, which glTF states and this
                      // renderer used to ignore -- it returned a constant (0,0,1)
                      // in object space, so Triangle and SimpleMeshes came out at
                      // ambient brightness and the north-star table said "lit: no"
                      // for both. The face normal is the cross product of two
                      // edges, wound to match glTF's counter-clockwise front.
                      let face = V3.normalize (V3.cross (V3.sub w1 w0) (V3.sub w2 w0)) in
                      let nrm_of = fn (k: int) -> match vnorm k with | None -> face | Some n -> n in
                      let c0 = M4.mul_v4 vp (V4.of_point w0) in
                      let c1 = M4.mul_v4 vp (V4.of_point w1) in
                      let c2 = M4.mul_v4 vp (V4.of_point w2) in
                      // NO NEAR-PLANE CLIPPING YET: a triangle with any vertex
                      // at or behind the eye is dropped whole. That is wrong for
                      // a camera inside geometry and right for every model in
                      // the corpus, which is framed from outside; clipping is
                      // recorded as owed rather than faked.
                      let ok = c0.w > 0.0 && c1.w > 0.0 && c2.w > 0.0 in
                      let _ =
                        if not ok then ()
                        else
                          // THE LAST TWO ARE SWAPPED, AND THAT IS NOT A TYPO.
                          //
                          // glTF's front face is counter-clockwise. The viewport
                          // transform below flips y -- a framebuffer's y grows
                          // downward and NDC's grows up -- and a flip REVERSES
                          // WINDING, so a front face arrives at the rasterizer
                          // counter-clockwise in ITS coordinates, where the
                          // convention is that clockwise is the front. Swapping
                          // two vertices puts it back.
                          //
                          // Without this the renderer culls every front face and
                          // draws the back ones, and the result LOOKS RIGHT: a box
                          // is still a box from the inside. What gave it away was
                          // that the whole model came out one flat colour --
                          // ambient only -- because the faces being drawn are the
                          // ones pointing away from the light. A silhouette is not
                          // evidence that the right triangles were drawn.
                          //
                          // A NEGATIVE-DETERMINANT TRANSFORM FLIPS IT BACK, and
                          // glTF says so in as many words: when the determinant of
                          // a node's global transform is negative, the winding
                          // order must be reversed. A mirroring scale turns every
                          // front face into a back one, so without this the whole
                          // model is inside out -- and it still looks like the
                          // model, which is why Khronos ships NegativeScaleTest.
                          let (ca, cb2, cc) = if flip then (c0, c1, c2) else (c0, c2, c1) in
                          let (wa, wb2, wc) = if flip then (w0, w1, w2) else (w0, w2, w1) in
                          let (ka, kb2, kc) = if flip then (k0, k1, k2) else (k0, k2, k1) in
                          let sx_of = fn (c: v4) -> (c.x / c.w * 0.5 + 0.5) * fw in
                          let sy_of = fn (c: v4) -> (0.5 - c.y / c.w * 0.5) * fh in
                          // Which side of this triangle is facing the eye, decided
                          // where the rasterizer decides it: on the projected
                          // area, in the order actually submitted.
                          let sarea = Raster.edge (sx_of ca) (sy_of ca) (sx_of cb2) (sy_of cb2)
                                                  (sx_of cc) (sy_of cc) in
                          // A DOUBLE-SIDED MATERIAL DRAWS THE BACK OF A SURFACE,
                          // and the back's normal points away from the eye --
                          // glTF says to negate it there. Without that the far
                          // side of a leaf or a sheet of paper is lit from behind
                          // and comes out at ambient: a dark shape that reads as a
                          // hole rather than as a surface.
                          let nsign = if sarea < 0.0 then 0.0 - 1.0 else 1.0 in
                          // THE TANGENT FRAME'S TWO VECTORS, per triangle when
                          // the primitive has no TANGENT.
                          //
                          // three.js takes the SCREEN-SPACE DERIVATIVES of the
                          // eye position and of the texture coordinate. A
                          // scanline rasterizer has no derivatives, so they are
                          // solved analytically from the triangle's own screen
                          // edges: for any attribute A,
                          //
                          //   [dA/dx, dA/dy] = [A1 - A0, A2 - A0] * inverse(M)
                          //
                          // where M is the 2x2 matrix of screen edges. THAT IS AN
                          // AFFINE ANSWER AND THE TRUE DERIVATIVE IS NOT AFFINE:
                          // under perspective three.js's varies across the
                          // triangle and this does not. The difference is stated
                          // rather than hidden, and it is small at the corpus's
                          // field of view.
                          //
                          // World space rather than eye space, which is
                          // equivalent here: the formula uses only differences
                          // and cross and dot products, and the world-to-eye
                          // transform of a look-at camera is a rotation and a
                          // translation, both of which those survive.
                          let ex1 = sx_of cb2 - sx_of ca in
                          let ey1 = sy_of ca - sy_of cb2 in
                          let ex2 = sx_of cc - sx_of ca in
                          let ey2 = sy_of ca - sy_of cc in
                          let sdet = ex1 * ey2 - ex2 * ey1 in
                          let (fa, fb) =
                            match tang with
                            // With tangents there is nothing to derive.
                            | Some _ -> (v3 { x = 0.0, y = 0.0, z = 0.0 },
                                         v3 { x = 0.0, y = 0.0, z = 0.0 })
                            | None ->
                              // A degenerate screen triangle has no frame, and
                              // zero is the answer that makes the normal map do
                              // nothing rather than divide by zero.
                              if sdet == 0.0 then (v3 { x = 0.0, y = 0.0, z = 0.0 },
                                                   v3 { x = 0.0, y = 0.0, z = 0.0 })
                              else
                                let inv = 1.0 / sdet in
                                let (u0, v0) = vuv ka in
                                let (u1, v1) = vuv kb2 in
                                let (u2, v2) = vuv kc in
                                let dp = fn (a1: v3) -> fn (a2: v3) ->
                                  // dA/dx and dA/dy from the two edge values.
                                  (V3.scale (V3.sub (V3.scale a1 ey2) (V3.scale a2 ey1)) inv,
                                   V3.scale (V3.sub (V3.scale a2 ex1) (V3.scale a1 ex2)) inv) in
                                let (q0, q1) = dp (V3.sub wb2 wa) (V3.sub wc wa) in
                                let du = fn (b1: float) -> fn (b2: float) ->
                                  ((b1 * ey2 - b2 * ey1) * inv, (b2 * ex1 - b1 * ex2) * inv) in
                                let (sx0, sx1) = du (u1 - u0) (u2 - u0) in
                                let (sy0, sy1) = du (v1 - v0) (v2 - v0) in
                                // cross(q1,N)*a + cross(N,q0)*b is cross(q1*a - q0*b, N),
                                // so the two vectors below are all the pixel needs.
                                (V3.sub (V3.scale q1 sx0) (V3.scale q0 sx1),
                                 V3.sub (V3.scale q1 sy0) (V3.scale q0 sy1)) in
                          let sv = fn (c: v4) -> fn (wp: v3) -> fn (n: v3) ->
                                   fn (k: int) ->
                            let iw = 1.0 / c.w in
                            let (uu, vv) = vuv k in
                            let (uu1, vv1) = vuv1 k in
                            let (cr, cg, cb) = vcol k in
                            // With tangents these are the vertex's own frame; the
                            // derived pair is constant across the triangle, and a
                            // constant survives interpolation as itself.
                            // THE FRAME FLIPS WITH THE FACE, not just the normal.
                            //
                            // A back face's normal is negated above (`nsign`), and
                            // three.js negates tbn[0] AND tbn[1] there too. Flipping
                            // only the normal leaves a frame no longer right-handed
                            // with it, so a double-sided surface gets its normal map
                            // applied backwards on the far side. Three of the five
                            // normal-mapped models are double-sided, including
                            // NormalTangentTest.
                            let (fav, fbv) = match vtan k n with
                                             | Some (tg, bt) ->
                                               (V3.scale tg nsign, V3.scale bt nsign)
                                             | None -> (V3.scale fa nsign, V3.scale fb nsign) in
                            svert { sx = (c.x * iw * 0.5 + 0.5) * fw,
                                    sy = (0.5 - c.y * iw * 0.5) * fh,
                                    sz = c.z * iw, siw = iw,
                                    wx = wp.x, wy = wp.y, wz = wp.z,
                                    nx = n.x * nsign, ny = n.y * nsign, nz = n.z * nsign,
                                    su = uu, sv = vv,
                                    su1 = uu1, sv1 = vv1,
                                    fax = fav.x, fay = fav.y, faz = fav.z,
                                    fbx = fbv.x, fby = fbv.y, fbz = fbv.z,
                                    cr = cr, cg = cg, cb = cb } in
                          let _ = vec_set drawn 0 (vec_get drawn 0 + 1) in
                          RasterS.triangle t depth (not mat.double_sided)
                            (sv ca wa (nrm_of ka) ka)
                            (sv cb2 wb2 (nrm_of kb2) kb2)
                            (sv cc wc (nrm_of kc) kc)
                            shader in
                      go (ti + 1) in

                  // POINTS AND LINES, UNLIT.
                  //
                  // three.js's GLTFLoader swaps the material for a
                  // `PointsMaterial` or a `LineBasicMaterial` for these modes,
                  // carrying over only `color` and `map`. Both are UNLIT, so the
                  // normal is never consulted and the emissive factor is dropped
                  // -- PrimitiveModeNormalsTest's material has
                  // `emissiveFactor [0, 0.1, 0.1]` and its points and lines do not
                  // show it. Its own comment on the point size reads "glTF spec
                  // says points should be 1px".
                  //
                  // So the colour is baseColorFactor * COLOR_0 * baseColorTexture,
                  // in LINEAR light, and `Srgb.encode` at the pixel is the only
                  // curve applied -- exactly where the triangle path applies it.
                  let thin_col = fn (k: int) ->
                    let (cr, cg, cb) = vcol k in
                    let (uu, vv) = vuv k in
                    let (uu1, vv1) = vuv1 k in
                    let tc = match btex with
                             | None -> v4 { x = 1.0, y = 1.0, z = 1.0, w = 1.0 }
                             | Some ts -> slot_sample ts true uu vv uu1 vv1 in
                    v3 { x = mat.br * cr * tc.x, y = mat.bg * cg * tc.y,
                         z = mat.bb * cb * tc.z } in
                  let thin_v = fn (k: int) ->
                    let c = M4.mul_v4 vp (V4.of_point (wpos k)) in
                    let iw = if c.w == 0.0 then 0.0 else 1.0 / c.w in
                    ((c.x * iw * 0.5 + 0.5) * fw, (0.5 - c.y * iw * 0.5) * fh,
                     c.z * iw, iw, c.w) in

                  // MODE 3 IS THE ONE WITH A WITNESS. The corpus has POINTS and
                  // LINE_STRIP and nothing else thin, so LINES and LINE_LOOP are
                  // written from the specification -- three lines of index pairing
                  // over drawing code the strip already exercises. Recorded rather
                  // than presented as tested.
                  let rec pts = fn (i: int) ->
                    if i >= vec_len idx then ()
                    else
                      let k = vec_get idx i in
                      let (sx, sy, z, iw, w) = thin_v k in
                      let _ = if w > 0.0 then
                                let _ = vec_set drawn 0 (vec_get drawn 0 + 1) in
                                RasterP.point t depth sx sy z (thin_col k)
                              else () in
                      pts (i + 1) in
                  let seg = fn (ka: int) -> fn (kb: int) ->
                    let (axx, ayy, az, aw, aww) = thin_v ka in
                    let (bxx, byy, bz, bw, bww) = thin_v kb in
                    // NO NEAR-PLANE CLIPPING HERE EITHER, so a segment with an
                    // endpoint at or behind the eye is dropped whole rather than
                    // drawn to a projected point that means nothing.
                    if aww <= 0.0 || bww <= 0.0 then ()
                    else
                      let _ = vec_set drawn 0 (vec_get drawn 0 + 1) in
                      RasterP.line t depth axx ayy az aw (thin_col ka)
                                            bxx byy bz bw (thin_col kb) in
                  let rec strip = fn (i: int) ->
                    if i + 1 >= vec_len idx then ()
                    else let _ = seg (vec_get idx i) (vec_get idx (i + 1)) in strip (i + 1) in
                  let rec pairs = fn (i: int) ->
                    if i + 1 >= vec_len idx then ()
                    else let _ = seg (vec_get idx i) (vec_get idx (i + 1)) in pairs (i + 2) in

                  if pmode == 0 then pts 0
                  else if pmode == 1 then pairs 0
                  else if pmode == 3 then strip 0
                  else if pmode == 2 then
                    // LINE_LOOP is a strip that closes.
                    let _ = strip 0 in
                    if vec_len idx >= 2
                    then seg (vec_get idx (vec_len idx - 1)) (vec_get idx 0)
                    else ()
                  else go 0 in
            prims rest in
        prims (J.arr (J.req mesh "primitives"))) in
    (t, depth, vec_get drawn 0, eye, ctr, th, zn, zf);

  // A FRESH CACHE PER CALL, so every existing caller is unchanged: one frame decodes
  // each image at most once instead of once per primitive, and nothing survives the
  // call. A frame LOOP wants the opposite and calls `one_frame_cached` with a cache
  // it keeps -- see src/view.mere.
  let one_frame_cam = fn (d: doc) -> fn (w: int) -> fn (h: int) -> fn (lit: bool) ->
                      fn (bg: v3) -> fn (time: float) -> fn (anim: int) ->
                      fn (cam: (v3 * v3 * float * float * float * mat4)) ->
    let c = tex_cache d in
    let _ = warm_cache d c in
    one_frame_cached d w h lit bg time anim cam c;

  // THE ANIMATION IS EVALUATED BEFORE THE CAMERA, and that ordering lives here
  // because this is the function that chooses a camera. The camera is framed from
  // the scene's bounds, and at time t those are the ANIMATED bounds -- framing first
  // would frame the still pose and let a moving model walk out of shot.
  let one_frame_anim = fn (d: doc) -> fn (w: int) -> fn (h: int) -> fn (lit: bool) ->
                       fn (bg: v3) -> fn (time: float) -> fn (anim: int) ->
    let ast = Scene.anim_state_of d time anim in
    let cam = Frame.auto_camera_at d (float_of_int w / float_of_int h) ast in
    one_frame_cam d w h lit bg time anim cam;

  let dflt_bg = v3 { x = 26.0, y = 26.0, z = 30.0 };
  let one_frame_at = fn (d: doc) -> fn (w: int) -> fn (h: int) -> fn (lit: bool) ->
                     fn (bg: v3) -> fn (time: float) -> one_frame_anim d w h lit bg time 0;
  let one_frame_bg = fn (d: doc) -> fn (w: int) -> fn (h: int) -> fn (lit: bool) ->
                     fn (bg: v3) -> one_frame_at d w h lit bg 0.0;
  let one_frame_opt = fn (d: doc) -> fn (w: int) -> fn (h: int) -> fn (lit: bool) ->
    one_frame_bg d w h lit dflt_bg;
  let one_frame = fn (d: doc) -> fn (w: int) -> fn (h: int) -> one_frame_opt d w h true;

  // The framebuffer as sRGB bytes, ready for a PNG. The renderer works in
  // linear light throughout and the curve is applied exactly once, here.
  let to_png_rgb = fn (t: target) ->
    let out = vec_new () in
    let rec go = fn (i: int) ->
      if i == t.w * t.h then out
      else
        let o = i * 4 in
        let _ = vec_push out (bytebuf_get t.color o) in
        let _ = vec_push out (bytebuf_get t.color (o + 1)) in
        let _ = vec_push out (bytebuf_get t.color (o + 2)) in
        go (i + 1) in
    go 0;
}
