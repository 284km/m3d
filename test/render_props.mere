// Properties of the whole pipeline, which need no reference.
//
// THE ONE THAT MATTERS IS THE WINDING, and it is here because it was wrong and
// the picture looked fine. glTF's front face is counter-clockwise; the viewport
// transform flips y, which reverses winding; the rasterizer's convention is that
// clockwise is the front. Get that chain wrong and every front face is culled
// and every back face is drawn -- and a box is still a box from the inside. The
// only visible symptom was that the whole model came out ONE FLAT COLOUR,
// because the faces being drawn are the ones pointing away from the light.
//
// A silhouette is not evidence that the right triangles were drawn. This file
// asks the question the silhouette cannot.
import "../src/render.mere";

let fails = vec_new ();
let check = fn (name: str) -> fn (ok: bool) ->
  if ok then () else let _ = vec_push fails name in print ("MISMATCH " ++ name);

// A minimal document, built here rather than loaded, so the winding is stated
// in this file and not inherited from a corpus model that might change. One
// triangle in the z = 0 plane, wound counter-clockwise as seen from +z, with a
// normal pointing at +z: a front face for a camera on the +z side.
let doc_of = fn (js: str) ->
  let p = "/tmp/m3d_render_props.gltf" in
  let _ = write_file p js in
  Gltf.load p;

// POSITION (-1,-1,0) (1,-1,0) (0,1,0) and NORMAL (0,0,1) x3, as raw float32
// little-endian in a data-free buffer... which this reader does not do, so the
// geometry is instead expressed through a tiny .bin written beside it.
// `node_extra` and `mat_extra` are spliced into the node and the material, which
// is how the mirroring scale and the doubleSided flag get in WITHOUT A SECOND
// COPY of this JSON to keep in step with the first.
let gltf_at = fn (node_extra: str) -> fn (mat_extra: str) -> fn (alpha: str) ->
             fn (prim_extra: str) -> fn (mesh_extra: str) ->
  "\{\"asset\":\{\"version\":\"2.0\"},\"scene\":0,\"scenes\":[\{\"nodes\":[0]}],"
  ++ "\"nodes\":[\{\"mesh\":0" ++ node_extra ++ "}],"
  // NO `indices`: the winding is chosen by the order the three positions are
  // written, below. An earlier version pointed this at an accessor with no
  // bufferView -- which glTF says reads as ZEROS, a fact this file's own comment
  // stated while the JSON above went on referencing it. The triangle came out
  // (v0, v0, v0), degenerate, and nothing drew.
  ++ "\"meshes\":[\{\"primitives\":[\{\"attributes\":\{\"POSITION\":0,\"NORMAL\":1},\"material\":0"
  ++ prim_extra ++ "}]" ++ mesh_extra ++ "}],"
  ++ "\"materials\":[\{\"pbrMetallicRoughness\":\{\"baseColorFactor\":[1.0,1.0,1.0," ++ alpha
  ++ "],\"metallicFactor\":0.0,\"roughnessFactor\":1.0}"
  ++ mat_extra ++ "}],"
  ++ "\"buffers\":[\{\"uri\":\"m3d_rp.bin\",\"byteLength\":108}],"
  ++ "\"bufferViews\":[\{\"buffer\":0,\"byteOffset\":0,\"byteLength\":36},"
  ++ "\{\"buffer\":0,\"byteOffset\":36,\"byteLength\":36},"
  // The third view is the morph target's displacements, written by `write_tri_n`
  // whether or not the document references them -- an unreferenced 36 bytes at the
  // end of a buffer is legal glTF and costs nothing, and it means the two documents
  // differ ONLY in their JSON.
  ++ "\{\"buffer\":0,\"byteOffset\":72,\"byteLength\":36}],"
  ++ "\"accessors\":[\{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\","
  ++ "\"min\":[-1.0,-1.0,0.0],\"max\":[1.0,1.0,0.0]},"
  ++ "\{\"bufferView\":1,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},"
  ++ "\{\"bufferView\":2,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\","
  ++ "\"min\":[-1.0,-1.0,0.0],\"max\":[1.0,1.0,0.0]}]}";

let gltf_full = fn (node_extra: str) -> fn (mat_extra: str) -> fn (alpha: str) ->
  gltf_at node_extra mat_extra alpha "" "";
let gltf_with = fn (node_extra: str) -> fn (mat_extra: str) ->
  gltf_at node_extra mat_extra "1.0" "" "";

// Rather than indices -- which would need a fourth bufferView and more hex --
// the winding is chosen by writing the three positions in the order asked for.
let write_tri_n = fn (a: int) -> fn (b: int) -> fn (c: int) -> fn (nz: float) ->
  let sb = strbuf_new () in
  let hexd = "0123456789abcdef" in
  let put = fn (x: float) ->
    let bb = f32_bits x in
    let rec go = fn (k: int) ->
      if k == 4 then ()
      else
        let v = bit_and (bit_shr bb (8 * k)) 255 in
        let _ = strbuf_push sb (char_at hexd (v / 16)) in
        let _ = strbuf_push sb (char_at hexd (v % 16)) in
        go (k + 1) in
    go 0 in
  let px = fn (k: int) -> if k == 0 then (0.0 - 1.0) else if k == 1 then 1.0 else 0.0 in
  let py = fn (k: int) -> if k == 2 then 1.0 else (0.0 - 1.0) in
  let one = fn (k: int) -> let _ = put (px k) in let _ = put (py k) in put 0.0 in
  let _ = one a in let _ = one b in let _ = one c in
  // three normals, all along z -- WHICH WAY IS THE CALLER'S BUSINESS, because a
  // surface seen from behind has its outward normal pointing away, and a back
  // face whose normal faces the camera is a file that cannot exist.
  let rec nrm = fn (k: int) ->
    if k == 3 then ()
    else let _ = put 0.0 in let _ = put 0.0 in let _ = put nz in nrm (k + 1) in
  let _ = nrm 0 in
  // THE MORPH TARGET'S DISPLACEMENTS, always written. v0 moves +0.5 in x and the
  // other two do not move at all, which makes the morphed triangle NARROWER -- a
  // change in SHAPE that the auto-camera cannot absorb by reframing, unlike a
  // displacement that moves the whole mesh.
  let dlt = fn (k: int) ->
    let _ = put (if k == 0 then 0.5 else 0.0) in let _ = put 0.0 in put 0.0 in
  let _ = dlt a in let _ = dlt b in let _ = dlt c in
  write_bytes "/tmp/m3d_rp.bin" (bytes_of_hex (strbuf_to_str sb));

// The ordinary case: an outward normal pointing at a camera on the +z side.
let write_tri = fn (a: int) -> fn (b: int) -> fn (c: int) -> write_tri_n a b c 1.0;

// Coverage and the brightest red, so "drawn" and "drawn facing the light" are
// two answers and not one. The flat box had the first and not the second.
let render_stats = fn () ->
  let d = Gltf.load "/tmp/m3d_rp.gltf" in
  let (t, dep, drawn, e, c, th, zn, zf) = Render.one_frame d 32 32 in
  let rec go = fn (i: int) -> fn (n: int) -> fn (mx: int) ->
    if i == 32 * 32 then (n, mx)
    else
      let (r, g, b) = Target.get t (i % 32) (i / 32) in
      let hit = if r == 26 && g == 26 && b == 30 then 0 else 1 in
      go (i + 1) (n + hit) (if hit == 1 && r > mx then r else mx) in
  go 0 0 0;

// Coverage and the brightest red say "drawn" and "drawn facing the light". A
// FRAME HASH answers a third question they cannot: whether two renders are the
// SAME PICTURE. A rotation applied to a whole model preserves its area and its
// bounds, so the auto-camera reframes it to the same size and the pixel COUNT
// does not move -- but the pixels do. That is exactly the shape of the skinning
// bug this file has to be able to see.
let render_hash = fn (path: str) ->
  let d = Gltf.load path in
  let (t, dep, drawn, e, c, th, zn, zf) = Render.one_frame d 32 32 in
  let rec go = fn (i: int) -> fn (h: int) ->
    if i == 32 * 32 then h
    else
      let (r, g, b) = Target.get t (i % 32) (i / 32) in
      // A position-sensitive mix, so two frames with the same pixels in different
      // places do not collide. `% 1000000007` keeps it inside an int.
      go (i + 1) ((h * 131 + r * 65536 + g * 256 + b + i) % 1000000007) in
  go 0 7;

let _ = write_file "/tmp/m3d_rp.gltf" (gltf_with "" "");

// Counter-clockwise seen from +z, and the framing puts the camera there: a
// FRONT face. Measured at 31 pixels of 1024 with a brightest red of 219 --
// the thresholds below are under those and not guesses. (The first version of
// this file guessed `> 50` and failed on a correct renderer.)
let _ = write_tri 0 1 2;
let (n_front, r_front) = render_stats ();
let _ = check "winding.front_face_is_drawn" (n_front > 20);
// AND IT IS LIT. This is the half the flat box would have failed: the geometry
// was there and the wrong side of it was facing the camera, so everything came
// out ambient-only. Ambient alone would be about 100 here.
let _ = check "winding.the_lit_side_faces_the_camera" (r_front > 180);

// The same triangle wound the other way is a back face and must vanish.
// Both halves are needed: a renderer that draws everything passes the first
// check and a renderer that draws nothing passes this one.
let _ = write_tri 0 2 1;
let (n_back, r_back) = render_stats ();
let _ = check "winding.back_face_is_culled" (n_back == 0);

// --- a mirroring transform reverses the winding order ------------------------
// glTF 3.7.4, in as many words: when the determinant of a node's global
// transform is negative, the winding order of the triangles MUST be reversed.
//
// Without it a mirrored model is inside out -- every front face culled, every
// back one drawn -- AND IT STILL LOOKS LIKE THE MODEL, which is the same trap
// the plain winding chain set and the reason Khronos ships NegativeScaleTest.
//
// Both directions are asserted, because either alone passes for a renderer that
// ignores the determinant in the convenient way: the CCW triangle must still be
// a FRONT face under the mirror, and the CW one must still be a BACK face.
// Dropping the rule swaps exactly those two answers.
let mirror = ",\"scale\":[-1.0,1.0,1.0]";
let _ = write_file "/tmp/m3d_rp.gltf" (gltf_with mirror "");
let _ = write_tri 0 1 2;
let (n_mf, r_mf) = render_stats ();
let _ = check "mirror.front_face_survives_the_mirror" (n_mf > 20);
let _ = check "mirror.and_is_still_the_lit_side" (r_mf > 180);
let _ = write_tri 0 2 1;
let (n_mb, r_mb) = render_stats ();
let _ = check "mirror.back_face_is_still_culled" (n_mb == 0);

// --- doubleSided draws the back, and lights it ------------------------------
// A single-sided material is the default, so this is the flag that ADDS pixels;
// twelve of the corpus's forty-nine models set it, and without it their back
// faces are holes.
//
// THE SECOND HALF IS THE ONE THAT MATTERS. A back face's normal points away
// from the eye, and glTF says to negate it there. Draw the back without doing
// that and the surface is lit from behind: it comes out at ambient, a dark shape
// that reads as a hole which happens not to be transparent. `r_back_lit > 180`
// is the same threshold the front face is held to, so the two sides have to be
// lit alike -- which is the whole claim.
let two_sided = ",\"doubleSided\":true";
let _ = write_file "/tmp/m3d_rp.gltf" (gltf_with "" two_sided);
// A CONSISTENT back face: wound the other way AND with its outward normal
// pointing away from the camera, which is what the far side of a real surface
// looks like. Handing the renderer a back face whose normal faces the camera is
// asking about a file that cannot exist -- it was written that way first, and the
// lighting check below failed on a renderer that was right.
let _ = write_tri_n 0 2 1 (0.0 - 1.0);
let (n_ds, r_ds) = render_stats ();
let _ = check "double_sided.the_back_is_drawn" (n_ds > 20);
let _ = check "double_sided.and_the_back_is_lit_not_ambient" (r_ds > 180);
// And it is the FLAG doing it, not the renderer having stopped culling: the
// same triangle with the flag off is still gone. Without this the pair above
// would pass for a renderer that had simply lost its back-face test.
let _ = write_file "/tmp/m3d_rp.gltf" (gltf_with "" "");
let (n_ds_off, r_ds_off) = render_stats ();
let _ = check "double_sided.is_off_by_default" (n_ds_off == 0);

// --- MASK cuts coverage ------------------------------------------------------
// `Shade.passes_alpha` was written, property-tested, and CALLED BY NOTHING --
// the second complete module in this project with no caller, and the second one
// a reference renderer noticed rather than a gate here. Two corpus models drew
// their masked-out labels as solid rectangles and every gate was green.
//
// MASK is a COVERAGE decision, so it is counted rather than looked at. The four
// cases below are the whole of what the specification says, and each of the last
// three is what stops the first from being passed by something simpler:
//
//   MASK above the cutoff draws        -- or nothing is ever drawn
//   MASK below the cutoff draws NOTHING -- the actual claim
//   OPAQUE below the cutoff still draws -- glTF says OPAQUE IGNORES alpha
//                                          ENTIRELY, which is not the same as
//                                          treating it as 1, and a renderer that
//                                          cut on alpha regardless would pass the
//                                          first two
//   BLEND below the cutoff still draws  -- BLEND changes colour, not coverage
let mask_m = ",\"alphaMode\":\"MASK\",\"alphaCutoff\":0.5";
let blend_m = ",\"alphaMode\":\"BLEND\"";
let with_alpha = fn (mat_extra: str) -> fn (alpha: str) ->
  let _ = write_file "/tmp/m3d_rp.gltf" (gltf_full "" mat_extra alpha) in
  render_stats ();

let _ = write_tri 0 1 2;
let (n_m_hi, r_m_hi) = with_alpha mask_m "1.0";
let _ = check "mask.above_the_cutoff_is_drawn" (n_m_hi > 20);
let (n_m_lo, r_m_lo) = with_alpha mask_m "0.4";
let _ = check "mask.below_the_cutoff_draws_nothing" (n_m_lo == 0);
let (n_o_lo, r_o_lo) = with_alpha "" "0.4";
let _ = check "mask.opaque_ignores_alpha_entirely" (n_o_lo > 20);
let (n_b_lo, r_b_lo) = with_alpha blend_m "0.4";
let _ = check "mask.blend_does_not_cut_coverage" (n_b_lo > 20);

// AND A DECLINED PIXEL MUST NOT WRITE DEPTH. A masked-out pixel is a hole, and a
// hole that occludes is worse than no hole: whatever is behind it disappears,
// which looks like a z-buffer bug a long way from the material that caused it.
//
// This one is here because the code CLAIMED it in a comment and nothing checked
// it -- poisoning the rasterizer to write depth on a declined pixel passed every
// property above. It needs two triangles at two depths, which the one-triangle
// document cannot express, so it is asked of the rasterizer directly.
let depth_not_written = fn () ->
  let sv = fn (k: int) -> fn (z: float) ->
    // A big triangle covering the middle of the frame, at a chosen depth.
    let sx = fn (i: int) -> if i == 0 then 2.0 else if i == 1 then 30.0 else 16.0 in
    let sy = fn (i: int) -> if i == 2 then 30.0 else 2.0 in
    svert { sx = sx k, sy = sy k, sz = z, siw = 1.0, su1 = 0.0, sv1 = 0.0,
            fax = 0.0, fay = 0.0, faz = 0.0, fbx = 0.0, fby = 0.0, fbz = 0.0,
            wx = 0.0, wy = 0.0, wz = 0.0, nx = 0.0, ny = 0.0, nz = 1.0,
            su = 0.0, sv = 0.0, cr = 1.0, cg = 1.0, cb = 1.0 } in
  // NEAR and declined: every pixel returns None.
  let declined = fn (w: v3) -> fn (n: v3) -> fn (u: float) -> fn (v: float) ->
                 fn (u1: float) -> fn (v1: float) -> fn (fa: v3) -> fn (fb: v3) -> fn (c: v3) -> (None : v3 option) in
  // FAR and drawn.
  let drawn = fn (w: v3) -> fn (n: v3) -> fn (u: float) -> fn (v: float) ->
              fn (u1: float) -> fn (v1: float) -> fn (fa: v3) -> fn (fb: v3) -> fn (c: v3) ->
    Some (v3 { x = 1.0, y = 1.0, z = 1.0 }) in
  let paint = fn (near) -> fn (far) ->
    let (t2, d2) = Target.make 32 32 in
    let _ = Target.clear t2 d2 0 0 0 in
    let _ = match near with
            | None -> ()
            | Some sh -> RasterS.triangle t2 d2 false (sv 0 0.1) (sv 1 0.1) (sv 2 0.1) sh in
    let _ = match far with
            | None -> ()
            | Some sh -> RasterS.triangle t2 d2 false (sv 0 0.9) (sv 1 0.9) (sv 2 0.9) sh in
    let rec count = fn (i: int) -> fn (n: int) ->
      if i == 32 * 32 then n
      else
        let (r, g, b) = Target.get t2 (i % 32) (i / 32) in
        count (i + 1) (n + (if r == 0 && g == 0 && b == 0 then 0 else 1)) in
    count 0 0 in
  // THREE NUMBERS, because one of them alone is passed by a triangle that covers
  // nothing: the same geometry with a drawing shader must cover pixels, with a
  // declining shader must cover none, and a farther triangle behind the declining
  // one must still show. Removing the near triangle entirely passes the third on
  // its own, which is how a vacuous property looks.
  (paint (Some drawn) None, paint (Some declined) None, paint (Some declined) (Some drawn));

let (n_covers, n_declines, n_behind) = depth_not_written ();
let _ = check "mask.the_test_geometry_covers_pixels" (n_covers > 20);
let _ = check "mask.a_declining_shader_draws_none_of_them" (n_declines == 0);
let _ = check "mask.a_declined_pixel_does_not_occlude" (n_behind > 20);

// --- per-pixel shading actually differs from per-vertex ----------------------
// EVERY MODEL IN THE CORPUS IS FLAT-FACED, so the north-star table cannot see
// this change at all: when a triangle's three normals are equal, interpolating
// them and interpolating the colours they produce give the same answer, and the
// numbers came out identical before and after. A property is the only thing
// that can tell the two apart here.
//
// One large triangle, three DIFFERENT normals, and the same geometry drawn both
// ways. Gouraud interpolates the three shaded colours; per-pixel interpolates
// the three normals and shades at each pixel. Those are different functions --
// shading is not linear in the normal -- so the middle of the triangle must
// come out differently.
let two_ways = fn () ->
  let (t1, d1) = Target.make 32 32 in
  let (t2, d2) = Target.make 32 32 in
  let _ = Target.clear t1 d1 0 0 0 in
  let _ = Target.clear t2 d2 0 0 0 in
  let mat = material { br = 1.0, bg = 1.0, bb = 1.0, ba = 1.0, metallic = 0.0,
                       roughness = 0.25, er = 0.0, eg = 0.0, eb = 0.0,
                       alpha_mode = 0, cutoff = 0.5, double_sided = false } in
  let li = dirlight { dx = 0.0, dy = 0.0, dz = 0.0 - 1.0, lr = 4.0, lg = 4.0, lb = 4.0 } in
  let eye = v3 { x = 0.0, y = 0.0, z = 10.0 } in
  // Normals fanned wide apart, so the interpolated one at the centre is a long
  // way from any of them and a low roughness makes the difference loud.
  let ns = fn (k: int) ->
    if k == 0 then V3.normalize (v3 { x = 0.0 - 0.8, y = 0.0 - 0.5, z = 0.4 })
    else if k == 1 then V3.normalize (v3 { x = 0.8, y = 0.0 - 0.5, z = 0.4 })
    else V3.normalize (v3 { x = 0.0, y = 0.9, z = 0.4 }) in
  let wp = fn (k: int) ->
    if k == 0 then v3 { x = 0.0 - 1.0, y = 0.0 - 1.0, z = 0.0 }
    else if k == 1 then v3 { x = 1.0, y = 0.0 - 1.0, z = 0.0 }
    else v3 { x = 0.0, y = 1.0, z = 0.0 } in
  let sx = fn (k: int) -> if k == 0 then 2.5 else if k == 1 then 29.5 else 16.0 in
  let sy = fn (k: int) -> if k == 0 then 29.5 else if k == 1 then 29.5 else 2.5 in
  let shade1 = fn (k: int) ->
    let vd = V3.normalize (V3.sub eye (wp k)) in
    V3.add (Shade.direct mat (ns k) vd li) (Shade.ambient mat 0.15) in
  // Gouraud, through the colour-interpolating entry point.
  let gv = fn (k: int) ->
    let l = shade1 k in
    rvert { x = sx k, y = sy k, z = 0.0, iw = 1.0, r = l.x, g = l.y, b = l.z } in
  let _ = Raster.triangle t1 d1 false (gv 0) (gv 1) (gv 2) in
  // Per pixel, through the attribute-carrying one.
  let pv = fn (k: int) ->
    let n = ns k in let w = wp k in
    svert { sx = sx k, sy = sy k, sz = 0.0, siw = 1.0, su1 = 0.0, sv1 = 0.0,
            fax = 0.0, fay = 0.0, faz = 0.0, fbx = 0.0, fby = 0.0, fbz = 0.0,
            wx = w.x, wy = w.y, wz = w.z, nx = n.x, ny = n.y, nz = n.z,
            su = 0.0, sv = 0.0, cr = 1.0, cg = 1.0, cb = 1.0 } in
  let shader = fn (w: v3) -> fn (n: v3) -> fn (u: float) -> fn (v: float) ->
               fn (u1: float) -> fn (v1: float) -> fn (fa: v3) -> fn (fb: v3) -> fn (c: v3) ->
    let vd = V3.normalize (V3.sub eye w) in
    Some (V3.add (Shade.direct mat n vd li) (Shade.ambient mat 0.15)) in
  let _ = RasterS.triangle t2 d2 false (pv 0) (pv 1) (pv 2) shader in
  (t1, t2);

let (tg, tp) = two_ways ();
let (rg, gg, bg) = Target.get tg 16 18;
let (rp, gp, bp) = Target.get tp 16 18;
// Both drew something at the centre, or the comparison below is vacuous.
let _ = check "shading.both_paths_drew" (rg > 0 && rp > 0);
let _ = check "shading.per_pixel_differs_from_gouraud" (rg != rp);
// And the difference is not a rounding wobble: a low-roughness highlight in the
// middle of a fanned triangle is a visible amount apart.
let _ = check "shading.the_difference_is_large" (
  (if rg > rp then rg - rp else rp - rg) > 8);
// The two agree EXACTLY when the three normals are the same, which is the case
// every corpus model is. Without this the check above could pass for a per-pixel
// path that was simply wrong.
let same_normals = fn () ->
  let (t1, d1) = Target.make 32 32 in
  let (t2, d2) = Target.make 32 32 in
  let _ = Target.clear t1 d1 0 0 0 in
  let _ = Target.clear t2 d2 0 0 0 in
  let mat = material { br = 1.0, bg = 1.0, bb = 1.0, ba = 1.0, metallic = 0.0,
                       roughness = 0.25, er = 0.0, eg = 0.0, eb = 0.0,
                       alpha_mode = 0, cutoff = 0.5, double_sided = false } in
  let li = dirlight { dx = 0.0, dy = 0.0, dz = 0.0 - 1.0, lr = 4.0, lg = 4.0, lb = 4.0 } in
  let eye = v3 { x = 0.0, y = 0.0, z = 10.0 } in
  let n = v3 { x = 0.0, y = 0.0, z = 1.0 } in
  let sx = fn (k: int) -> if k == 0 then 2.5 else if k == 1 then 29.5 else 16.0 in
  let sy = fn (k: int) -> if k == 0 then 29.5 else if k == 1 then 29.5 else 2.5 in
  // The same world position for all three, so the view vector is identical too
  // and only the shading path differs.
  let w = v3 { x = 0.0, y = 0.0, z = 0.0 } in
  let vd = V3.normalize (V3.sub eye w) in
  let l = V3.add (Shade.direct mat n vd li) (Shade.ambient mat 0.15) in
  let gv = fn (k: int) -> rvert { x = sx k, y = sy k, z = 0.0, iw = 1.0,
                                  r = l.x, g = l.y, b = l.z } in
  let _ = Raster.triangle t1 d1 false (gv 0) (gv 1) (gv 2) in
  let pv = fn (k: int) -> svert { sx = sx k, sy = sy k, sz = 0.0, siw = 1.0, su1 = 0.0, sv1 = 0.0,
            fax = 0.0, fay = 0.0, faz = 0.0, fbx = 0.0, fby = 0.0, fbz = 0.0,
                                  wx = w.x, wy = w.y, wz = w.z,
                                  nx = n.x, ny = n.y, nz = n.z,
                                  su = 0.0, sv = 0.0, cr = 1.0, cg = 1.0, cb = 1.0 } in
  let shader = fn (ww: v3) -> fn (nn: v3) -> fn (u: float) -> fn (v: float) ->
               fn (u1: float) -> fn (v1: float) -> fn (fa: v3) -> fn (fb: v3) -> fn (c: v3) ->
    Some (V3.add (Shade.direct mat nn (V3.normalize (V3.sub eye ww)) li)
                 (Shade.ambient mat 0.15)) in
  let _ = RasterS.triangle t2 d2 false (pv 0) (pv 1) (pv 2) shader in
  let rec cmp = fn (i: int) -> fn (bad: int) ->
    if i == 32 * 32 then bad
    else
      let (a, b, c) = Target.get t1 (i % 32) (i / 32) in
      let (x, y, z) = Target.get t2 (i % 32) (i / 32) in
      cmp (i + 1) (bad + (if a == x && b == y && c == z then 0 else 1)) in
  cmp 0 0;
let _ = check "shading.flat_normals_agree_exactly" (same_normals () == 0);

// --- morph targets are DISPLACEMENTS, and a weight blends them --------------
// A target's `POSITION` is how far each vertex MOVES, not where it ends up.
// Reading them as absolute positions collapses a mesh toward the origin, which
// looks like a scale bug a long way from the material that caused it.
//
// The target here moves v0 by +0.5 in x and leaves the other two alone, so the
// triangle gets NARROWER -- a change in SHAPE, which the auto-camera cannot
// absorb by reframing the way it absorbs a displacement of the whole mesh.
//
// The numbers were MEASURED before being asserted: 118 pixels unmorphed, 118 at
// weight 0, 105 at weight 0.5, 93 at weight 1.
let mtgt = ",\"targets\":[\{\"POSITION\":2}]";
let mw = fn (w: str) -> ",\"weights\":[" ++ w ++ "]";
let at_w = fn (w: str) ->
  let _ = write_file "/tmp/m3d_rp.gltf" (gltf_at "" "" "1.0" mtgt (mw w)) in
  render_stats ();
let _ = write_tri 0 1 2;
let (n_no, r_no) = let _ = write_file "/tmp/m3d_rp.gltf" (gltf_with "" "") in render_stats ();
let (n_w0, r_w0) = at_w "0.0";
let (n_w1, r_w1) = at_w "1.0";
let (n_wh, r_wh) = at_w "0.5";

// A WEIGHT OF ZERO MUST CHANGE NOTHING. Two corpus models carry targets and
// all-zero weights -- their animations drive them -- so at rest they have to be
// identical to the unmorphed mesh, and this is that statement in one line.
let _ = check "morph.a_zero_weight_changes_nothing" (n_w0 == n_no && r_w0 == r_no);
// AND A FULL WEIGHT MUST MOVE IT. Without this the one above passes for a
// renderer that ignores morph targets entirely, which is what this one did.
let _ = check "morph.a_full_weight_moves_the_vertex" (n_w1 < n_no - 15);
// A weight blends: half of it lands strictly between the two ends.
let _ = check "morph.a_half_weight_lands_between" (n_wh > n_w1 && n_wh < n_no);
// AND IT IS A DISPLACEMENT, NOT A POSITION. Read as an absolute position, v0
// would sit at (0.5, 0, 0) -- nearly collinear with the other two -- and the
// triangle would lose most of its area rather than a tenth of it. 93 pixels is
// the displacement reading; the absolute one is around 30.
let _ = check "morph.the_target_is_a_displacement" (n_w1 > 60);

// A NODE'S WEIGHTS OVERRIDE ITS MESH'S, so that two nodes can instance one mesh
// at two poses. Nothing in the corpus uses the node form -- which is why this is
// here: the priority was written from the specification, and a rule with no
// witness is a rule nobody has checked. Reversing the two passes every property
// above, measured.
//
// The node says full weight and the mesh says none, so the morphed count is the
// right answer and the unmorphed one is what taking the mesh's would give.
let _ = write_file "/tmp/m3d_rp.gltf" (gltf_at (mw "1.0") "" "1.0" mtgt (mw "0.0"));
let (n_nodew, r_nodew) = render_stats ();
let _ = check "morph.a_nodes_weights_override_its_meshs" (n_nodew == n_w1);


// --- skinning ----------------------------------------------------------------
// FIVE OF THE SIX SKINNED MODELS IN THE CORPUS CANNOT SEE THIS FEATURE AT ALL.
// Their joints sit at their bind pose at rest, so every joint matrix is the
// identity and skinning is a no-op -- measured: SimpleSkin, RiggedSimple,
// RiggedFigure and Fox render BYTE-IDENTICALLY with skinning implemented and
// with it absent. Only RecursiveSkeletons moves (IoU 0.199 to 0.999). So the
// corpus is nearly blind here and these properties are the check.
//
// A self-contained document, because a skin needs joint nodes, a skin object and
// three more accessors, and threading those through the shared builder would make
// every other test's JSON carry them.
let skin_bin = fn () ->
  let sb = strbuf_new () in
  let hexd = "0123456789abcdef" in
  let put32 = fn (bb: int) ->
    let rec go = fn (k: int) ->
      if k == 4 then ()
      else
        let v = bit_and (bit_shr bb (8 * k)) 255 in
        let _ = strbuf_push sb (char_at hexd (v / 16)) in
        let _ = strbuf_push sb (char_at hexd (v % 16)) in
        go (k + 1) in
    go 0 in
  let putf = fn (x: float) -> put32 (f32_bits x) in
  let put16 = fn (n: int) ->
    let lo = n % 256 in let hi = (n / 256) % 256 in
    let _ = strbuf_push sb (char_at hexd (lo / 16)) in
    let _ = strbuf_push sb (char_at hexd (lo % 16)) in
    let _ = strbuf_push sb (char_at hexd (hi / 16)) in
    strbuf_push sb (char_at hexd (hi % 16)) in
  // 0..35 POSITION: the same triangle the winding tests use.
  let px = fn (k: int) -> if k == 0 then (0.0 - 1.0) else if k == 1 then 1.0 else 0.0 in
  let py = fn (k: int) -> if k == 2 then 1.0 else (0.0 - 1.0) in
  let rec pos = fn (k: int) ->
    if k == 3 then ()
    else let _ = putf (px k) in let _ = putf (py k) in let _ = putf 0.0 in pos (k + 1) in
  let _ = pos 0 in
  // 36..71 NORMAL, all +z.
  let rec nrm = fn (k: int) ->
    if k == 3 then ()
    else let _ = putf 0.0 in let _ = putf 0.0 in let _ = putf 1.0 in nrm (k + 1) in
  let _ = nrm 0 in
  // 72..95 JOINTS_0: VERTEX 0 FOLLOWS JOINT 0 AND THE OTHER TWO FOLLOW JOINT 1.
  // Splitting them is what makes moving a joint change the triangle's SHAPE --
  // a whole-mesh translation is absorbed by the auto-camera, which this project
  // has already been caught by once.
  //
  // The three unused slots are 9999, WHICH IS NOT A JOINT. glTF allows any value
  // where the matching weight is zero, so a reader that looks the joint up before
  // testing the weight indexes out of bounds on a legal file. This is that file.
  let rec joints = fn (k: int) ->
    if k == 3 then ()
    else
      let _ = put16 (if k == 0 then 0 else 1) in
      let _ = put16 9999 in let _ = put16 9999 in let _ = put16 9999 in
      joints (k + 1) in
  let _ = joints 0 in
  // 96..143 WEIGHTS_0: all of it on the first slot.
  let rec wts = fn (k: int) ->
    if k == 3 then ()
    else let _ = putf 1.0 in let _ = putf 0.0 in let _ = putf 0.0 in let _ = putf 0.0 in
         wts (k + 1) in
  let _ = wts 0 in
  // 144..271 inverseBindMatrices, two identities.
  let rec ibm = fn (k: int) ->
    if k == 2 then ()
    else
      let rec e = fn (i: int) ->
        if i == 16 then ()
        else let _ = putf (if i % 5 == 0 then 1.0 else 0.0) in e (i + 1) in
      let _ = e 0 in
      ibm (k + 1) in
  let _ = ibm 0 in
  // 272..399 the SECOND set of inverse bind matrices: joint 0's is a translation
  // of -0.5 in x. An inverse bind matrix takes a vertex out of the pose the mesh
  // was authored in, so applying this one shifts vertex 0 the other way -- which
  // is how "is the inverse bind matrix used at all" gets an answer.
  let rec ibm2 = fn (k: int) ->
    if k == 2 then ()
    else
      let rec e = fn (i: int) ->
        if i == 16 then ()
        else
          let v = if i % 5 == 0 then 1.0
                  else if i == 12 && k == 0 then (0.0 - 0.5)
                  else 0.0 in
          let _ = putf v in e (i + 1) in
      let _ = e 0 in
      ibm2 (k + 1) in
  let _ = ibm2 0 in
  write_bytes "/tmp/m3d_skin.bin" (bytes_of_hex (strbuf_to_str sb));

// `node_x` goes on the MESH node, `joint_x` translates joint 0, and `ibm_off`
// picks which of the two inverse-bind blocks to use.
let skin_gltf = fn (node_x: str) -> fn (joint_x: str) -> fn (ibm_off: int) -> fn (skinned: bool) ->
  "\{\"asset\":\{\"version\":\"2.0\"},\"scene\":0,\"scenes\":[\{\"nodes\":[0,1,2]}],"
  ++ "\"nodes\":[\{\"mesh\":0" ++ (if skinned then ",\"skin\":0" else "") ++ node_x ++ "},"
  ++ "\{\"translation\":[" ++ joint_x ++ ",0.0,0.0]},\{}],"
  ++ "\"skins\":[\{\"joints\":[1,2],\"inverseBindMatrices\":" ++ str_of_int (if ibm_off == 0 then 4 else 5) ++ "}],"
  ++ "\"meshes\":[\{\"primitives\":[\{\"attributes\":\{\"POSITION\":0,\"NORMAL\":1,"
  ++ "\"JOINTS_0\":2,\"WEIGHTS_0\":3},\"material\":0}]}],"
  ++ "\"materials\":[\{\"pbrMetallicRoughness\":\{\"baseColorFactor\":[1.0,1.0,1.0,1.0],"
  ++ "\"metallicFactor\":0.0,\"roughnessFactor\":1.0}}],"
  ++ "\"buffers\":[\{\"uri\":\"m3d_skin.bin\",\"byteLength\":400}],"
  ++ "\"bufferViews\":[\{\"buffer\":0,\"byteOffset\":0,\"byteLength\":36},"
  ++ "\{\"buffer\":0,\"byteOffset\":36,\"byteLength\":36},"
  ++ "\{\"buffer\":0,\"byteOffset\":72,\"byteLength\":24},"
  ++ "\{\"buffer\":0,\"byteOffset\":96,\"byteLength\":48},"
  ++ "\{\"buffer\":0,\"byteOffset\":144,\"byteLength\":128},"
  ++ "\{\"buffer\":0,\"byteOffset\":272,\"byteLength\":128}],"
  ++ "\"accessors\":[\{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\","
  ++ "\"min\":[-1.0,-1.0,0.0],\"max\":[1.0,1.0,0.0]},"
  ++ "\{\"bufferView\":1,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},"
  ++ "\{\"bufferView\":2,\"componentType\":5123,\"count\":3,\"type\":\"VEC4\"},"
  ++ "\{\"bufferView\":3,\"componentType\":5126,\"count\":3,\"type\":\"VEC4\"},"
  ++ "\{\"bufferView\":4,\"componentType\":5126,\"count\":2,\"type\":\"MAT4\"},"
  ++ "\{\"bufferView\":5,\"componentType\":5126,\"count\":2,\"type\":\"MAT4\"}]}";

let skin_at = fn (node_x: str) -> fn (joint_x: str) -> fn (ibm_off: int) -> fn (skinned: bool) ->
  let _ = write_file "/tmp/m3d_skin.gltf" (skin_gltf node_x joint_x ibm_off skinned) in
  render_hash "/tmp/m3d_skin.gltf";

let _ = skin_bin ();
let h_rest = skin_at "" "0.0" 0 true;
let h_moved = skin_at "" "0.5" 0 true;
// MOVING A JOINT MOVES THE VERTICES THAT FOLLOW IT. Vertex 0 follows joint 0 and
// the other two follow joint 1, so this changes the triangle's shape.
let _ = check "skin.moving_a_joint_moves_the_mesh" (h_rest != h_moved);
// AND A JOINT AT ITS BIND POSE CHANGES NOTHING -- the same frame as the same
// document with no skin at all. Without this the one above passes for a renderer
// that transforms vertices by something arbitrary.
let h_unskinned = skin_at "" "0.0" 0 false;
let _ = check "skin.a_bind_pose_joint_changes_nothing" (h_rest == h_unskinned);

// THE MESH NODE'S OWN TRANSFORM IS IGNORED WHEN THE MESH IS SKINNED. The joint
// matrices already carry the vertex to world space; applying the node's
// transform on top transforms the model twice.
//
// The transform is a ROTATION and not a translation or a scale, because the
// auto-camera reframes those away -- it follows the bounds -- and this project
// has been caught by exactly that before. A rotation preserves area and bounds
// here, so the pixel COUNT does not move either; only the picture does, which is
// why this compares frame hashes.
let rot90 = ",\"rotation\":[0.0,0.0,0.7071067811865476,0.7071067811865476]";
let h_skin_rot = skin_at rot90 "0.0" 0 true;
let _ = check "skin.the_nodes_own_transform_is_ignored" (h_skin_rot == h_rest);
// AND THE ROTATION IS VISIBLE AT ALL, on the same document without the skin.
// Without this the property above passes for a renderer that ignores rotations.
let h_norot = skin_at rot90 "0.0" 0 false;
let _ = check "skin.and_that_rotation_does_show_unskinned" (h_norot != h_unskinned);

// THE INVERSE BIND MATRIX IS APPLIED. The second block translates joint 0's by
// -0.5 in x, which moves vertex 0 and nothing else.
let h_ibm = skin_at "" "0.0" 1 true;
let _ = check "skin.the_inverse_bind_matrix_is_applied" (h_ibm != h_rest);

// A ZERO WEIGHT'S JOINT INDEX IS NEVER READ. The unused slots of JOINTS_0 above
// hold 9999, which is not a joint -- glTF allows any value there -- so a reader
// that looks the joint up before testing the weight walks off the end of the
// skin. That every render above happened at all is the check; this line says so.
let _ = check "skin.a_zero_weight_does_not_read_its_joint" (h_rest != 0);


// --- normal mapping ----------------------------------------------------------
// A CONSTANT MAP, so the answer is computable by hand rather than a picture.
// test/data/png/normal_tilt.png says (0.482, 0.482, 0.741) at every texel, tilted
// in BOTH x and y -- x alone would not notice a wrong bitangent, and TANGENT's w
// is exactly a statement about which way the bitangent goes.
//
// One quad in the z = 0 plane with UVs along x and y and TANGENT (1,0,0,w). So
// T = (1,0,0), N = (0,0,1), B = cross(N,T)*w = (0,w,0), and the perturbed normal
// is (0.482, 0.482w, 0.741) normalized. The light travels (-0.4,-0.7,-0.6), so it
// has a strong y component and the two signs of w are not the same brightness.
//
// THE CORPUS CANNOT CHECK ANY OF THIS. All five of its normal-mapped models use
// scale = 1, and only NormalTangentMirrorTest exercises w at all -- one witness.
let nm_bin_n = fn (w: float) -> fn (nx: float) -> fn (ny: float) -> fn (nz: float) ->
  let sb = strbuf_new () in
  let hexd = "0123456789abcdef" in
  let put32 = fn (bb: int) ->
    let rec go = fn (k: int) ->
      if k == 4 then ()
      else
        let v = bit_and (bit_shr bb (8 * k)) 255 in
        let _ = strbuf_push sb (char_at hexd (v / 16)) in
        let _ = strbuf_push sb (char_at hexd (v % 16)) in
        go (k + 1) in
    go 0 in
  let putf = fn (x: float) -> put32 (f32_bits x) in
  // POSITION: two triangles making a quad from (-1,-1) to (1,1).
  let qx = fn (k: int) -> if k == 0 || k == 3 then (0.0 - 1.0) else if k == 2 || k == 4 then 1.0
                          else if k == 1 then 1.0 else (0.0 - 1.0) in
  let qy = fn (k: int) -> if k == 0 || k == 1 then (0.0 - 1.0) else if k == 3 then (0.0 - 1.0)
                          else 1.0 in
  let rec pos = fn (k: int) ->
    if k == 6 then ()
    else let _ = putf (qx k) in let _ = putf (qy k) in let _ = putf 0.0 in pos (k + 1) in
  let _ = pos 0 in
  // NORMAL -- the caller's, because one test bakes the map's answer in here.
  let rec nrm = fn (k: int) ->
    if k == 6 then ()
    else let _ = putf nx in let _ = putf ny in let _ = putf nz in nrm (k + 1) in
  let _ = nrm 0 in
  // TEXCOORD_0, along x and y. The map is constant so the exact layout does not
  // change the answer -- but a zero UV gradient would make a DERIVED frame
  // degenerate, and this document is also the one that will test that path.
  let rec uv = fn (k: int) ->
    if k == 6 then ()
    else let _ = putf ((qx k + 1.0) * 0.5) in let _ = putf ((qy k + 1.0) * 0.5) in uv (k + 1) in
  let _ = uv 0 in
  // TANGENT: (1,0,0,w).
  let rec tan = fn (k: int) ->
    if k == 6 then ()
    else let _ = putf 1.0 in let _ = putf 0.0 in let _ = putf 0.0 in let _ = putf w in
         tan (k + 1) in
  let _ = tan 0 in
  write_bytes "/tmp/m3d_nm.bin" (bytes_of_hex (strbuf_to_str sb));

let nm_bin = fn (w: float) -> nm_bin_n w 0.0 0.0 1.0;

let nm_gltf_raw = fn (scale: str) -> fn (with_tangent: bool) -> fn (with_map: bool) ->
  "\{\"asset\":\{\"version\":\"2.0\"},\"scene\":0,\"scenes\":[\{\"nodes\":[0]}],"
  ++ "\"nodes\":[\{\"mesh\":0}],"
  ++ "\"meshes\":[\{\"primitives\":[\{\"attributes\":\{\"POSITION\":0,\"NORMAL\":1,"
  ++ "\"TEXCOORD_0\":2" ++ (if with_tangent then ",\"TANGENT\":3" else "") ++ "},\"material\":0}]}],"
  ++ "\"materials\":[\{\"pbrMetallicRoughness\":\{\"baseColorFactor\":[1.0,1.0,1.0,1.0],"
  ++ "\"metallicFactor\":0.0,\"roughnessFactor\":1.0}"
  ++ (if with_map then ",\"normalTexture\":\{\"index\":0,\"scale\":" ++ scale ++ "}" else "") ++ "}],"
  ++ "\"textures\":[\{\"source\":0}],\"images\":[\{\"uri\":\"normal_tilt.png\"}],"
  ++ "\"buffers\":[\{\"uri\":\"m3d_nm.bin\",\"byteLength\":264}],"
  ++ "\"bufferViews\":[\{\"buffer\":0,\"byteOffset\":0,\"byteLength\":72},"
  ++ "\{\"buffer\":0,\"byteOffset\":72,\"byteLength\":72},"
  ++ "\{\"buffer\":0,\"byteOffset\":144,\"byteLength\":48},"
  ++ "\{\"buffer\":0,\"byteOffset\":192,\"byteLength\":96}],"
  ++ "\"accessors\":[\{\"bufferView\":0,\"componentType\":5126,\"count\":6,\"type\":\"VEC3\","
  ++ "\"min\":[-1.0,-1.0,0.0],\"max\":[1.0,1.0,0.0]},"
  ++ "\{\"bufferView\":1,\"componentType\":5126,\"count\":6,\"type\":\"VEC3\"},"
  ++ "\{\"bufferView\":2,\"componentType\":5126,\"count\":6,\"type\":\"VEC2\"},"
  ++ "\{\"bufferView\":3,\"componentType\":5126,\"count\":6,\"type\":\"VEC4\"}]}";

let nm_gltf = fn (scale: str) -> fn (with_tangent: bool) ->
  nm_gltf_raw scale with_tangent true;

let nm_at = fn (scale: str) -> fn (with_tangent: bool) -> fn (w: float) ->
  let _ = nm_bin w in
  let _ = write_file "/tmp/m3d_nm.gltf" (nm_gltf scale with_tangent) in
  // The image sits beside test/data/png, so the document goes there too.
  let _ = write_file "test/data/png/m3d_nm.gltf" (nm_gltf scale with_tangent) in
  let _ = write_bytes "test/data/png/m3d_nm.bin" (read_bytes "/tmp/m3d_nm.bin") in
  render_hash "test/data/png/m3d_nm.gltf";

// The same document with the map's normal BAKED INTO THE GEOMETRY instead: the
// vertex normals are set to what the map says and there is no normalTexture. By
// construction the two must render identically -- the map contributes
// T*0.4824 + B*0.4824 + N*0.7412, and with T=(1,0,0), B=(0,1,0), N=(0,0,1) that
// IS (0.4824, 0.4824, 0.7412), which is what these normals are.
//
// THIS IS THE ONLY ABSOLUTE CHECK HERE, and it is here because the other four are
// relative: they compare map-on against map-off against half-scale, so an error
// that moves EVERY sampled value the same way breaks none of them. Sampling the
// map through the sRGB transfer curve is exactly that error -- 0.741 decodes to
// 0.51 and every hash shifts together -- and it passed all four.
let nm_baked = fn () ->
  let _ = nm_bin_n 1.0 0.4824 0.4824 0.7412 in
  let _ = write_file "test/data/png/m3d_nm.gltf" (nm_gltf_raw "1.0" true false) in
  let _ = write_bytes "test/data/png/m3d_nm.bin" (read_bytes "/tmp/m3d_nm.bin") in
  render_hash "test/data/png/m3d_nm.gltf";

let h_nm_on  = nm_at "1.0" true 1.0;
let h_nm_off = nm_at "0.0" true 1.0;
let h_nm_neg = nm_at "1.0" true (0.0 - 1.0);
let h_nm_half = nm_at "0.5" true 1.0;

// A NORMAL MAP BENDS THE NORMAL. Without this every property below passes for a
// renderer that ignores normal maps, which is what this one did.
let _ = check "normalmap.it_changes_the_shading" (h_nm_on != h_nm_off);
// scale = 0 IS THE UNPERTURBED SURFACE. glTF multiplies x and y by scale and
// leaves z alone, so zero flattens the map rather than zeroing the normal -- a
// renderer that scaled all three would get a zero vector and have to guess.
let _ = check "normalmap.scale_zero_is_the_plain_normal" (h_nm_off != 0);
// AND scale IS A DIAL, not a switch: half of it is neither end.
let _ = check "normalmap.scale_is_a_dial" (h_nm_half != h_nm_on && h_nm_half != h_nm_off);
// TANGENT's w FLIPS THE BITANGENT. The map is tilted in y as well as x, so the
// two signs are two different normals -- and the light has a strong y component,
// so they are two different brightnesses. The corpus has one witness for this
// (NormalTangentMirrorTest); this is the second.
let _ = check "normalmap.the_tangent_w_flips_the_bitangent" (h_nm_neg != h_nm_on);
// AND THE MAP'S EFFECT IS THE NORMAL IT NAMES. Baking (0.4824, 0.4824, 0.7412)
// into the vertex normals and removing the map must give the same frame, because
// that is what T*x + B*y + N*z comes to for this tangent basis. An error that
// scales every sampled value -- decoding the map through the sRGB curve, say --
// leaves all four checks above passing and breaks this one.
let _ = check "normalmap.equals_baking_that_normal_into_the_geometry" (nm_baked () == h_nm_on);

// WITHOUT TANGENT THE MAP IS NOT APPLIED, and that is a decision rather than an
// omission. The code to derive a frame from the texture coordinates is in
// render.mere and it is turned off: it agrees with the SUPPLIED frame on this
// quad -- which is m3d against m3d, self-consistency and not an oracle -- and it
// disagrees more with three.js on all three corpus models that need it.
//
// glTF names MikkTSpace for this case, three.js uses per-pixel screen-space
// derivatives, and that code computes per-triangle affine gradients: three
// algorithms, and agreement between two of them is not conformance to the third.
//
// This property pins the decision, so switching the path on has to come with a
// deliberate edit here rather than happening quietly.
let h_nm_derived = nm_at "1.0" false 1.0;
let h_nm_none = nm_at "0.0" false 1.0;
let _ = check "normalmap.without_tangents_the_map_is_left_alone" (h_nm_derived == h_nm_none);


// --- points and lines --------------------------------------------------------
// A third rasterizer entry point, so it gets its own properties rather than
// borrowing the triangle's. These call it DIRECTLY: the questions are about one
// pixel and one segment, and routing them through a glTF document would put the
// loader between the question and the answer.
let pl_frame = fn (paint) ->
  let (t, dep) = Target.make 32 32 in
  let _ = Target.clear t dep 0 0 0 in
  let _ = paint t dep in
  let rec go = fn (i: int) -> fn (n: int) ->
    if i == 32 * 32 then n
    else
      let (r, g, b) = Target.get t (i % 32) (i / 32) in
      go (i + 1) (n + (if r == 0 && g == 0 && b == 0 then 0 else 1)) in
  go 0 0;
let white = v3 { x = 1.0, y = 1.0, z = 1.0 };

// A POINT IS ONE PIXEL. three.js sets sizeAttenuation to false for glTF points
// with the comment "glTF spec says points should be 1px", so this is the
// reference's own answer and not a simplification of it.
let _ = check "point.is_exactly_one_pixel"
  (pl_frame (fn (t) -> fn (d) -> RasterP.point t d 8.5 9.5 0.5 white) == 1);
// And outside the frame it is no pixels rather than a fault.
let _ = check "point.outside_the_frame_is_dropped"
  (pl_frame (fn (t) -> fn (d) -> let _ = RasterP.point t d (0.0 - 5.0) 9.5 0.5 white in
                                 RasterP.point t d 99.0 9.5 0.5 white) == 0);
// A POINT RESPECTS DEPTH, and this READS THE COLOUR rather than counting pixels.
// Counting cannot see it: with no depth test the far point OVERWRITES the near
// one at the same pixel and the count is still one. Measured -- removing the
// depth test passed a counting version of this check.
let pl_pixel = fn (paint) ->
  let (t, dep) = Target.make 32 32 in
  let _ = Target.clear t dep 0 0 0 in
  let _ = paint t dep in
  let (r, g, b) = Target.get t 8 9 in
  r;
let red = v3 { x = 1.0, y = 0.0, z = 0.0 };
let dim = v3 { x = 0.2, y = 0.0, z = 0.0 };
// The NEAR point is bright and the far one dim, so which survives is legible in
// one channel. Both orderings, because either alone passes for a renderer that
// always keeps the first write or always keeps the last.
let _ = check "point.the_near_one_wins_whichever_is_drawn_first"
  (pl_pixel (fn (t) -> fn (d) -> let _ = RasterP.point t d 8.5 9.5 0.2 red in
                                 RasterP.point t d 8.5 9.5 0.8 dim)
   == pl_pixel (fn (t) -> fn (d) -> let _ = RasterP.point t d 8.5 9.5 0.8 dim in
                                    RasterP.point t d 8.5 9.5 0.2 red));
let _ = check "point.and_the_near_one_is_the_bright_one"
  (pl_pixel (fn (t) -> fn (d) -> let _ = RasterP.point t d 8.5 9.5 0.8 dim in
                                 RasterP.point t d 8.5 9.5 0.2 red) > 200);

// A LINE REACHES BOTH ITS ENDPOINTS. A horizontal run of 10 pixels is 10 pixels:
// Bresenham inclusive of both ends, which is what makes two segments of a strip
// meet rather than leave a gap at every joint.
let hline = fn (t) -> fn (d) ->
  RasterP.line t d 2.5 5.5 0.5 1.0 white 11.5 5.5 0.5 1.0 white;
let _ = check "line.spans_both_endpoints" (pl_frame hline == 10);
// A diagonal is as long as its LONG axis, not the sum of the two -- a line that
// stepped both axes every pixel would draw 20 here and look twice as thick.
let _ = check "line.a_diagonal_is_as_long_as_its_long_axis"
  (pl_frame (fn (t) -> fn (d) ->
     RasterP.line t d 2.5 2.5 0.5 1.0 white 11.5 7.5 0.5 1.0 white) == 10);
// A line is clipped, not wrapped: a segment leaving the frame draws the part
// inside it and no pixel on the far edge.
let _ = check "line.is_clipped_not_wrapped"
  (pl_frame (fn (t) -> fn (d) ->
     RasterP.line t d 28.5 5.5 0.5 1.0 white 40.5 5.5 0.5 1.0 white) == 4);
// AND A LINE RESPECTS DEPTH, read as a colour for the same reason.
let pl_line_pixel = fn (paint) ->
  let (t, dep) = Target.make 32 32 in
  let _ = Target.clear t dep 0 0 0 in
  let _ = paint t dep in
  let (r, g, b) = Target.get t 5 5 in
  r;
let _ = check "line.the_near_one_wins"
  (pl_line_pixel (fn (t) -> fn (d) ->
     let _ = RasterP.line t d 2.5 5.5 0.8 1.0 dim 11.5 5.5 0.8 1.0 dim in
     RasterP.line t d 2.5 5.5 0.2 1.0 red 11.5 5.5 0.2 1.0 red) > 200);
let _ = check "line.and_the_far_one_does_not_overwrite_it"
  (pl_line_pixel (fn (t) -> fn (d) ->
     let _ = RasterP.line t d 2.5 5.5 0.2 1.0 red 11.5 5.5 0.2 1.0 red in
     RasterP.line t d 2.5 5.5 0.8 1.0 dim 11.5 5.5 0.8 1.0 dim) > 200);

let n = vec_len fails;
print (if n == 0 then "render_props: ok" else "render_props: " ++ str_of_int n ++ " FAILED")
